# 复制为 /etc/huotong-aftersales.env 并填写，权限设为 600（chmod 600 /etc/huotong-aftersales.env）
# 此文件含密钥，不要提交到仓库、不要发给别人。

# 小程序 AppSecret（小程序后台 → 开发管理 → 开发设置）
WeChat__AppSecret=

# JWT 签名密钥：≥32 位随机字符串，可用 `openssl rand -base64 48` 生成。改了之后所有人需要重新登录。
Jwt__Key=

# 第一个主管账号（仅在库里还没有任何主管时创建一次）
Bootstrap__SupervisorName=
Bootstrap__SupervisorPhone=
# 电脑后台初始密码：至少 8 位，需同时含字母和数字；登录后可在后台修改
Bootstrap__SupervisorPassword=

# 钉钉群机器人（可选）
DingTalk__Webhook=
DingTalk__Secret=
