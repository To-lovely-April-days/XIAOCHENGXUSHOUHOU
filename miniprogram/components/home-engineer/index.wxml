<!-- 今日现场工时 -->
<view class="hero">
  <view class="dial">
    <image wx:if="{{clockSrc}}" class="dial-img" src="{{clockSrc}}" aria-label="今日现场时间表盘" />
    <text class="dial-num n12">12</text>
    <text class="dial-num n3">3</text>
    <text class="dial-num n6">6</text>
    <text class="dial-num n9">9</text>
  </view>
  <view class="hero-main">
    <view class="hero-label">今日现场工时</view>
    <view class="hero-clock" aria-label="今日现场工时 {{clockHm}}">{{clockHm}}<text class="hero-ss">{{clockSs}}</text></view>
    <view class="hero-lines">
      <view wx:for="{{heroLines}}" wx:key="index" class="hero-line {{item.muted ? 'muted' : ''}}">
        <text wx:if="{{item.dot}}" class="hdot hdot-{{item.dot}}"></text>
        <text>{{item.text}}</text><text wx:if="{{item.strong}}" class="hero-strong">{{item.strong}}</text>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{status === 'loading'}}" class="state-box">加载中…</view>
<view wx:elif="{{status === 'error'}}">
  <empty text="首页加载失败" desc="{{errorText}}">
    <view class="btn-sm btn-secondary" hover-class="btn-hover" bindtap="onRetry">重试</view>
  </empty>
</view>

<view wx:else class="main">

  <!-- ===== 处理中：当前工单 ===== -->
  <view wx:if="{{state === 'working' && current}}" class="hcard" aria-label="当前工单">
    <view class="order-head" hover-class="row-hover" data-id="{{current.id}}" bindtap="toDetail">
      <view class="badge">{{current.badge}}</view>
      <view class="flex1">
        <view class="oh-name ellipsis">{{current.customerName}}</view>
        <view class="oh-sub ellipsis">{{current.deviceLine}}</view>
      </view>
      <text wx:if="{{current.assist}}" class="tag tag-sm assist-tag">协助</text>
    </view>

    <view class="steps" aria-label="工单进度">
      <view wx:for="{{steps}}" wx:key="key" class="step" aria-current="{{item.state === 'current' ? 'step' : ''}}">
        <view wx:if="{{item.line}}" class="step-line {{item.line}}"></view>
        <view class="step-dot {{item.state}}">
          <ui-icon wx:if="{{item.state === 'done'}}" name="check" color="#FFFFFF" size="14" stroke="3" />
          <view wx:elif="{{item.state === 'current'}}" class="step-inner"></view>
        </view>
        <text class="step-label {{item.state}}">{{item.label}}</text>
        <text class="step-sub">{{item.sub}}</text>
      </view>
    </view>

    <block wx:if="{{currentOnsite && currentOnSite}}">
      <view class="btn-red mt16" hover-class="btn-hover" data-id="{{current.id}}" bindtap="toCheckin">
        <ui-icon name="camera" color="#FFFFFF" size="18" stroke="2" />离场打卡
      </view>
      <view class="hint">中途离开现场也打离场卡，回来后再打到场卡</view>
    </block>
    <block wx:elif="{{currentOnsite}}">
      <view class="btn-grid mt16">
        <view wx:if="{{current.assist}}" class="btn-soft" hover-class="btn-hover" data-id="{{current.id}}" bindtap="toDetail">查看详情</view>
        <view wx:else class="btn-soft" hover-class="btn-hover" data-id="{{current.id}}" bindtap="toComplete">提交完工</view>
        <view class="btn-red" hover-class="btn-hover" data-id="{{current.id}}" bindtap="toCheckin">
          <ui-icon name="camera" color="#FFFFFF" size="18" stroke="2" />到场打卡
        </view>
      </view>
      <view class="hint">{{current.assist ? '你是本单协助人：到场、离场各打一次卡，工时按本人计算' : '回到现场后打到场卡；处理完成并离场后提交完工'}}</view>
    </block>
    <block wx:elif="{{current.factory}}">
      <view class="btn-dark mt16" hover-class="btn-hover" data-id="{{current.id}}" bindtap="toDetail">查看返厂流程</view>
      <view class="hint">{{current.factoryText ? current.factoryText + ' · ' : ''}}返厂工单在详情页记录返厂节点，寄回客户后提交完工</view>
    </block>
    <block wx:elif="{{current.assist}}">
      <view class="btn-dark mt16" hover-class="btn-hover" data-id="{{current.id}}" bindtap="toDetail">查看详情</view>
      <view class="hint">你是本单协助人，完工由负责人提交</view>
    </block>
    <block wx:else>
      <view class="btn-dark mt16" hover-class="btn-hover" data-id="{{current.id}}" bindtap="toComplete">提交完工</view>
      <view class="hint">远程工单无需打卡，处理完成后提交完工</view>
    </block>
  </view>

  <!-- ===== 待启动：下一单 ===== -->
  <view wx:if="{{state === 'next' && next}}" class="hcard" aria-label="下一单">
    <view class="row-between">
      <view class="row gap8">
        <status-tag status="{{next.status}}" />
        <text wx:if="{{next.assist}}" class="tag tag-sm assist-tag">协助</text>
      </view>
      <text class="order-no">{{next.orderNo}}</text>
    </view>
    <view class="order-head mt-10" hover-class="row-hover" data-id="{{next.id}}" bindtap="toDetail">
      <view class="badge">{{next.badge}}</view>
      <view class="flex1">
        <view class="oh-name ellipsis">{{next.customerName}}</view>
        <view class="oh-sub ellipsis2">{{next.deviceLine}}</view>
      </view>
    </view>
    <view class="info">
      <view class="info-row">
        <text class="info-k">预约</text>
        <text class="info-v {{next.appointmentTime ? 'num' : 'amber'}}">{{next.apptText}}</text>
      </view>
      <view class="info-row">
        <text class="info-k">地址</text>
        <text class="info-v">{{next.address || '—'}}</text>
      </view>
      <view class="info-row" hover-class="row-hover" bindtap="onCall" aria-role="button" aria-label="拨打联系人电话">
        <text class="info-k">联系人</text>
        <view class="info-v row">
          <text>{{next.contactName || '—'}}</text>
          <block wx:if="{{next.contactPhone}}"><text> · </text><text class="num phone">{{next.phoneText}}</text>
            <view class="phone-icon"><ui-icon name="phone" color="#1D1D1F" size="16" stroke="1.8" /></view>
          </block>
        </view>
      </view>
    </view>
    <view wx:if="{{next.onsite}}" class="btn-grid-12 mt12">
      <view class="btn-soft" hover-class="btn-hover" bindtap="onNavigate">
        <ui-icon name="location" color="#1D1D1F" size="18" stroke="2" />导航
      </view>
      <view class="btn-red" hover-class="btn-hover" data-id="{{next.id}}" bindtap="toCheckin">
        <ui-icon name="camera" color="#FFFFFF" size="18" stroke="2" />到场打卡
      </view>
    </view>
    <view wx:elif="{{next.factory}}" class="btn-dark mt12" hover-class="btn-hover" data-id="{{next.id}}" bindtap="toDetail">查看返厂流程</view>
    <view wx:elif="{{next.assist}}" class="btn-dark mt12" hover-class="btn-hover" data-id="{{next.id}}" bindtap="toDetail">查看详情</view>
    <view wx:else class="btn-dark mt12" hover-class="btn-hover" data-id="{{next.id}}" bindtap="toDetail">去开始处理</view>
    <view class="hint">{{next.onsite ? '到达客户现场后拍照打卡；距客户 1 公里以外会被标记' : '远程工单在详情页点「开始处理」；返厂工单在详情页记录返厂节点'}}</view>
  </view>

  <!-- ===== 空闲 ===== -->
  <view wx:if="{{state === 'idle' || (state === 'working' && !current) || (state === 'next' && !next)}}" class="hcard idle" aria-label="当前状态">
    <view class="idle-title">当前暂无进行中的工单</view>
    <view class="idle-desc">{{idleDesc}}</view>
    <view class="btn-grid mt14">
      <view class="btn-soft" hover-class="btn-hover" bindtap="toNew">新建工单</view>
      <view class="btn-dark" hover-class="btn-hover" bindtap="toHall">去认领</view>
    </view>
  </view>

  <!-- ===== 后续安排 ===== -->
  <view wx:if="{{state !== 'idle' && upcoming.length}}" aria-label="后续安排">
    <view class="sec-head"><text class="sec-title">后续安排</text></view>
    <view wx:for="{{upcoming}}" wx:key="id" class="up-item {{index > 0 ? 'mt-10' : ''}}" hover-class="row-hover" data-id="{{item.id}}" bindtap="toDetail">
      <view class="up-date">
        <text class="up-week">{{item.weekText}}</text>
        <text class="up-day">{{item.dayText}}</text>
      </view>
      <view class="flex1">
        <view class="row gap8"><text class="up-name ellipsis">{{item.customerName}}</text><text wx:if="{{item.assist}}" class="tag tag-sm assist-tag">协助</text></view>
        <view class="oh-sub ellipsis"><text class="num-plain">{{item.apptText}}</text><text wx:if="{{item.deviceModel}}"> · {{item.deviceModel}}</text></view>
      </view>
      <ui-icon name="right" color="#AEAEB2" size="18" stroke="2" />
    </view>
  </view>

  <!-- ===== 待认领 ===== -->
  <view wx:if="{{hall.count > 0 || state === 'idle'}}" aria-label="待认领">
    <view class="sec-head">
      <text class="sec-title">待认领 <text class="sec-count">{{hall.count}}</text></text>
      <view class="sec-link" hover-class="btn-hover" bindtap="toHall">全部<ui-icon name="right" color="#1D1D1F" size="16" stroke="2" /></view>
    </view>
    <view wx:if="{{!hall.items.length}}" class="state-box card-box">工单大厅暂无待认领工单</view>
    <view wx:for="{{hall.items}}" wx:key="id" class="hall-item {{index > 0 ? 'mt-10' : ''}}" hover-class="row-hover" data-id="{{item.id}}" bindtap="toDetail">
      <view class="badge">{{item.badge}}</view>
      <view class="flex1">
        <view class="row hall-title">
          <text class="hall-name ellipsis">{{item.customerName}}</text>
          <urgency-tag urgency="{{item.urgency}}" />
        </view>
        <view class="oh-sub ellipsis mt-3">{{item.meta}}</view>
      </view>
      <ui-icon name="right" color="#AEAEB2" size="18" stroke="2" />
    </view>
  </view>

  <!-- ===== 暂停搁置（本人参与） ===== -->
  <view wx:if="{{onHold.length}}" aria-label="暂停搁置">
    <view class="sec-head">
      <text class="sec-title">暂停搁置 <text class="sec-count">{{onHold.length}}</text></text>
    </view>
    <view class="list-card">
      <view wx:for="{{onHold}}" wx:key="id" class="done-item" hover-class="row-hover" data-id="{{item.id}}" bindtap="toDetail">
        <view class="hold-mark"><view class="hold-bar"></view><view class="hold-bar"></view></view>
        <view class="flex1">
          <view class="row gap8"><text class="done-name ellipsis">{{item.customerName}}</text><text wx:if="{{item.assist}}" class="tag tag-sm assist-tag">协助</text></view>
          <view class="oh-sub hold-line ellipsis">{{item.holdLine}}</view>
        </view>
        <ui-icon name="right" color="#AEAEB2" size="18" stroke="2" />
      </view>
    </view>
  </view>

  <!-- ===== 最近完成 ===== -->
  <view wx:if="{{state === 'idle' && recentDone.length}}" aria-label="最近完成">
    <view class="sec-head">
      <text class="sec-title">最近完成</text>
      <view class="sec-link" hover-class="btn-hover" bindtap="toMyOrders">全部<ui-icon name="right" color="#1D1D1F" size="16" stroke="2" /></view>
    </view>
    <view class="list-card">
      <view wx:for="{{recentDone}}" wx:key="id" class="done-item" hover-class="row-hover" data-id="{{item.id}}" bindtap="toDetail">
        <view class="flex1">
          <view class="done-name ellipsis">{{item.customerName}}</view>
          <view class="oh-sub num-plain">{{item.meta}}</view>
        </view>
        <status-tag status="{{item.status}}" />
      </view>
    </view>
  </view>
</view>
