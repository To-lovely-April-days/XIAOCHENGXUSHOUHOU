<view class="avatar" style="width: {{size * 2}}rpx; height: {{size * 2}}rpx; background: {{url && !failed ? '#E5E5E3' : bg}}; color: {{color}}; font-size: {{size * 0.84}}rpx;" aria-label="{{user && user.name ? user.name + '的头像' : '头像'}}">
  <image wx:if="{{url && !failed}}" class="avatar-img" src="{{url}}" mode="aspectFill" lazy-load binderror="onError" />
  <text wx:else>{{letter}}</text>
</view>
