.tabbar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 500;
  display: flex;
  height: calc(132rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  box-shadow: 0 -2rpx 0 #E5E5E3;
  box-sizing: border-box;
}
.tab { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; height: 132rpx; }
.icon { width: 48rpx; height: 48rpx; }
.label { font-size: 22rpx; line-height: 28rpx; font-weight: 500; color: #AEAEB2; }
.label.on { color: #1D1D1F; font-weight: 600; }
.tab-wide { flex: 2; }
.tab-center { justify-content: flex-start; gap: 8rpx; }
.center-btn {
  width: 112rpx; height: 112rpx; margin-top: -44rpx;
  box-sizing: border-box; border-radius: 56rpx; border: 8rpx solid #FFFFFF;
  display: flex; align-items: center; justify-content: center;
}
.center-icon { width: 52rpx; height: 52rpx; }
.label-center { font-weight: 700; }
