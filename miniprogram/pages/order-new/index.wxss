/* pages/order-new（原型 15） */
page { background: var(--bg); }
.form { padding-bottom: 24rpx; }
.num-font { font-family: var(--font-num); font-variant-numeric: tabular-nums; }
.star { color: var(--red); }
.intro { padding: 16rpx 48rpx 0; font-size: 26rpx; line-height: 38rpx; color: var(--text-2); }
.grp-title { padding: 36rpx 48rpx 16rpx; font-size: 26rpx; font-weight: 600; color: var(--text-2); }
.grp { margin: 0 32rpx; background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow); padding: 0 32rpx; }
.grp-pb { padding-bottom: 32rpx; }

.cell { display: flex; align-items: center; gap: 20rpx; min-height: 104rpx; border-bottom: 2rpx solid var(--divider); font-size: 32rpx; color: var(--text); }
.cell-tall { min-height: 120rpx; padding: 12rpx 0; }
.cell-addr { min-height: 128rpx; padding: 16rpx 0; }
.no-line { border-bottom: none; }
.cell-hover { opacity: 0.7; }

.lbl { flex-shrink: 0; font-size: 32rpx; color: var(--text); }
.lbl.err { color: var(--red); }
.hint { font-size: 26rpx; color: var(--text-2); margin-top: 4rpx; }
.hint-inline { font-size: 26rpx; color: var(--text-2); font-weight: 400; }
.val { flex-shrink: 0; color: var(--text-2); font-size: 32rpx; }
.val.red { color: var(--red); }

.ipt { flex: 1; min-width: 0; height: 88rpx; font-size: 32rpx; color: var(--text); text-align: right; }
.ipt-block { display: block; width: 100%; height: 88rpx; font-size: 32rpx; color: var(--text); }
.block { padding-top: 28rpx; border-bottom: 2rpx solid var(--divider); }
.ta { display: block; width: 100%; min-height: 128rpx; padding: 12rpx 0 20rpx; font-size: 32rpx; line-height: 48rpx; color: var(--text); }

.addr { flex: 1; min-width: 0; text-align: right; line-height: 44rpx; }
.addr-name { font-size: 32rpx; color: var(--text); word-break: break-all; }
.addr-sub { font-size: 26rpx; color: var(--text-2); line-height: 36rpx; word-break: break-all; }
.addr-tag { font-size: 26rpx; color: var(--text-2); }
.addr-tag.amber { color: var(--amber); }

.pick-chip { height: 64rpx; padding: 0 24rpx; border-radius: 16rpx; background: var(--bg); display: flex; align-items: center; font-size: 30rpx; color: var(--text); }
.pick-chip.placeholder { color: var(--text-3); }


.media-title { padding: 32rpx 0 16rpx; font-size: 32rpx; }
.media-title-first { padding-top: 24rpx; }
.media-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16rpx; }
.media-item { position: relative; height: 144rpx; border-radius: 12rpx; background: var(--track); overflow: hidden; }
.media-img { width: 100%; height: 100%; display: block; }
.media-video { position: absolute; left: 10rpx; bottom: 8rpx; font-size: 22rpx; color: #FFFFFF; font-weight: 600; text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.6); }
.media-mask { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.45); color: #FFFFFF; font-size: 22rpx; display: flex; align-items: center; justify-content: center; }
.media-fail { background: rgba(200, 30, 43, 0.75); }
.media-del { position: absolute; top: 0; right: 0; width: 44rpx; height: 44rpx; border-bottom-left-radius: 12rpx; background: rgba(0, 0, 0, 0.55); display: flex; align-items: center; justify-content: center; }
.media-add { height: 144rpx; border-radius: 12rpx; border: 2rpx solid #D1D1CF; background: var(--card); display: flex; align-items: center; justify-content: center; }
.media-title.err { color: var(--red); }
/* v1.2 附件：文档格子（类型角标 + 文件名）、受限锁标、上传进度、提示 */
.media-doc { position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 20rpx 10rpx 0; display: flex; flex-direction: column; align-items: center; gap: 10rpx; background: var(--soft); }
.media-badge { flex-shrink: 0; min-width: 64rpx; height: 56rpx; padding: 0 10rpx; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; color: #FFFFFF; font-size: 22rpx; font-weight: 700; }
.media-name { width: 100%; text-align: center; font-size: 20rpx; line-height: 28rpx; color: var(--text-body); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.media-lock { position: absolute; top: 0; left: 0; z-index: 2; width: 44rpx; height: 44rpx; border-bottom-right-radius: 12rpx; background: var(--amber); display: flex; align-items: center; justify-content: center; }
.media-del { z-index: 2; }
.media-fatal { padding: 0 8rpx; text-align: center; font-size: 20rpx; line-height: 28rpx; }
.media-hint { margin-top: 20rpx; font-size: 24rpx; line-height: 36rpx; }

.submit { height: 100rpx; border-radius: 24rpx; font-size: 32rpx; }
