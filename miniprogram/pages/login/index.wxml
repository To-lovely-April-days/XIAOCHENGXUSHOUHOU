<view class="login">
  <!-- 顶部精密光学氛围层（纯 CSS，不拦截点击） -->
  <view class="hero-bg" aria-hidden="true">
    <view class="bg-glow"></view>
    <view class="bg-arc bg-arc-outer"></view>
    <view class="bg-arc bg-arc-inner"></view>
  </view>

  <nav-bar back="{{false}}" fixed="{{false}}" background="transparent" />

  <!-- 品牌页头 -->
  <view class="hero">
    <view class="brand-bar">
      <image class="logo-img" src="/assets/logo.png" mode="aspectFit" />
      <view class="scope-pill">
        <view class="scope-dot"></view>
        <text>内部员工端</text>
      </view>
    </view>
    <view class="hero-title">霍桐售后工单</view>
    <view class="hero-sub">售后工单流转 · 现场打卡 · 工时协同</view>
  </view>

  <!-- 主功能卡片 -->
  <view class="auth-card">
    <!-- ===== 登录 ===== -->
    <block wx:if="{{step === 'login'}}">
      <view class="card-title">账号登录</view>
      <view class="card-desc">用手机号和密码登录。登录一次后 30 天内不用再输密码。</view>

      <view class="form">
      <view class="field">
        <text class="field-label">手机号</text>
        <view class="field-box">
          <input class="field-input num-plain" type="number" maxlength="11" value="{{phone}}" data-k="phone" bindinput="onInput"
                 placeholder="11 位手机号" placeholder-class="field-ph" />
        </view>
      </view>
      <view class="field">
        <text class="field-label">密码</text>
        <view class="field-box">
          <input class="field-input" password="{{!showPwd}}" maxlength="64" value="{{password}}" data-k="password" bindinput="onInput"
                 placeholder="请输入密码" placeholder-class="field-ph" confirm-type="done" bindconfirm="onSubmitLogin" />
          <text class="field-eye" catchtap="togglePwd" aria-role="button">{{showPwd ? '隐藏' : '显示'}}</text>
        </view>
      </view>
      </view>

      <view class="cta-wrap">
        <view class="cta-btn cta-active {{busy ? 'cta-busy' : ''}}" hover-class="cta-hover" bindtap="onSubmitLogin" aria-role="button">
          <text>{{busy ? '登录中…' : '登录'}}</text>
        </view>
      </view>

      <view class="consent-row {{tried && !agreed ? 'consent-warn' : ''}} {{shakeAgree ? 'is-shake' : ''}}"
            bindtap="toggleAgree" aria-role="checkbox" aria-checked="{{agreed}}">
        <view class="check-box {{agreed ? 'is-on' : ''}} {{tried && !agreed ? 'is-warn' : ''}}">
          <ui-icon wx:if="{{agreed}}" name="check" color="#FFFFFF" size="11" stroke="3" />
        </view>
        <view class="consent-body">
          <view class="consent-text">已阅读并同意 <text class="consent-link" catchtap="openPrivacy">《用户隐私保护指引》</text>，同意使用手机号、位置和相机</view>
          <view wx:if="{{tried && !agreed}}" class="consent-tip" aria-role="alert">请先勾选同意隐私保护指引</view>
        </view>
      </view>

      <view wx:if="{{error}}" class="alert-banner" aria-role="alert">
        <view class="alert-icon"><ui-icon name="wx-warn" color="#C81E2B" size="17" /></view>
        <view class="alert-text">
          <text>{{error}}</text>
          <view wx:if="{{canReapply}}" class="alert-link" bindtap="toRegister" aria-role="button">修改后重新提交</view>
        </view>
      </view>

      <view class="switch-row">
        <text>还没有账号？</text>
        <text class="switch-link" bindtap="toRegister" aria-role="button">注册账号</text>
      </view>
    </block>

    <!-- ===== 注册 ===== -->
    <block wx:elif="{{step === 'register'}}">
      <view class="card-title">注册账号</view>
      <view class="card-desc">提交后由管理员审批并分配角色，通过后即可登录。</view>

      <view class="form">
        <view class="field">
          <text class="field-label">姓名</text>
          <view class="field-box">
            <input class="field-input" maxlength="20" value="{{name}}" data-k="name" bindinput="onInput"
                   placeholder="请填写真实姓名" placeholder-class="field-ph" />
          </view>
        </view>
      <view class="field">
        <text class="field-label">手机号</text>
        <view class="field-box">
          <input class="field-input num-plain" type="number" maxlength="11" value="{{phone}}" data-k="phone" bindinput="onInput"
                 placeholder="11 位手机号" placeholder-class="field-ph" />
        </view>
      </view>
      <view class="field">
        <text class="field-label">密码</text>
        <view class="field-box">
          <input class="field-input" password="{{!showPwd}}" maxlength="64" value="{{password}}" data-k="password" bindinput="onInput"
                 placeholder="至少 8 位，包含字母和数字" placeholder-class="field-ph" confirm-type="next" />
          <text class="field-eye" catchtap="togglePwd" aria-role="button">{{showPwd ? '隐藏' : '显示'}}</text>
        </view>
      </view>
      <view class="field">
        <text class="field-label">确认密码</text>
        <view class="field-box">
          <input class="field-input" password="{{!showPwd}}" maxlength="64" value="{{confirm}}" data-k="confirm" bindinput="onInput"
                 placeholder="再输入一次密码" placeholder-class="field-ph" confirm-type="done" bindconfirm="onSubmitRegister" />
          <text class="field-eye" catchtap="togglePwd" aria-role="button">{{showPwd ? '隐藏' : '显示'}}</text>
        </view>
      </view>
      </view>

      <view class="cta-wrap">
        <view class="cta-btn cta-active {{busy ? 'cta-busy' : ''}}" hover-class="cta-hover" bindtap="onSubmitRegister" aria-role="button">
          <text>{{busy ? '提交中…' : '提交注册'}}</text>
        </view>
      </view>

      <view class="consent-row {{tried && !agreed ? 'consent-warn' : ''}} {{shakeAgree ? 'is-shake' : ''}}"
            bindtap="toggleAgree" aria-role="checkbox" aria-checked="{{agreed}}">
        <view class="check-box {{agreed ? 'is-on' : ''}} {{tried && !agreed ? 'is-warn' : ''}}">
          <ui-icon wx:if="{{agreed}}" name="check" color="#FFFFFF" size="11" stroke="3" />
        </view>
        <view class="consent-body">
          <view class="consent-text">已阅读并同意 <text class="consent-link" catchtap="openPrivacy">《用户隐私保护指引》</text>，同意使用手机号、位置和相机</view>
          <view wx:if="{{tried && !agreed}}" class="consent-tip" aria-role="alert">请先勾选同意隐私保护指引</view>
        </view>
      </view>

      <view wx:if="{{error}}" class="alert-banner" aria-role="alert">
        <view class="alert-icon"><ui-icon name="wx-warn" color="#C81E2B" size="17" /></view>
        <text class="alert-text">{{error}}</text>
      </view>

      <view class="switch-row">
        <text>已有账号？</text>
        <text class="switch-link" bindtap="toLoginStep" aria-role="button">返回登录</text>
      </view>
    </block>

    <!-- ===== 等待审批 ===== -->
    <block wx:elif="{{step === 'pending'}}">
      <view class="status-pill">
        <ui-icon name="wx-info" color="#636366" size="13" />
        <text>等待审批</text>
      </view>
      <view class="card-title mt-title">{{pendingTitle}}</view>
      <view class="card-desc">{{pendingDesc}}</view>
      <view class="cta-wrap">
        <view class="cta-btn cta-active" hover-class="cta-hover" bindtap="toLoginStep" aria-role="button">
          <text>返回登录</text>
        </view>
      </view>
    </block>

    <!-- ===== 首次登录：设置头像 ===== -->
    <block wx:else>
      <view class="emp-pass">
        <view class="emp-pass-top">
          <view class="emp-badge-row">
            <ui-icon name="wx-safe" color="#2F7A4B" size="17" />
            <text class="emp-verified">登录成功</text>
          </view>
          <text class="emp-source">员工账号</text>
        </view>
        <view class="emp-pass-divider"></view>
        <view class="emp-pass-head">
          <text class="emp-name ellipsis">{{user.name}}</text>
          <text wx:if="{{roleName}}" class="emp-role">{{roleName}}</text>
        </view>
        <view class="emp-meta num-plain">
          <text>{{phoneMasked}}</text>
          <text wx:if="{{department}}"> · {{department}}</text>
        </view>
      </view>

      <view class="avatar-stage">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" aria-label="设置头像" disabled="{{uploading}}">
          <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
          <view wx:else class="avatar-empty">
            <text wx:if="{{surname}}" class="avatar-surname">{{surname}}</text>
            <ui-icon wx:else name="user" color="#6E6E73" size="38" stroke="1.6" />
          </view>
          <view class="avatar-cam">
            <ui-icon name="wx-camera" color="#FFFFFF" size="14" />
          </view>
        </button>

        <view class="avatar-title">{{uploading ? '头像上传中…' : (avatarUrl ? '已设置个人头像' : '设置个人头像')}}</view>
        <view class="avatar-desc">{{avatarUrl ? '点击上方头像可随时重新更换，将显示在工单与打卡记录中' : '头像会显示在工单和打卡记录中，不设置则默认显示姓氏'}}</view>

        <view class="avatar-pill" hover-class="cta-hover" bindtap="onPickAvatar" aria-role="button">
          <ui-icon name="wx-album" color="#1D1D1F" size="16" />
          <text>从相册选择或拍照</text>
        </view>
      </view>

      <view class="avatar-actions">
        <view wx:if="{{avatarUrl}}" class="cta-btn cta-active" hover-class="cta-hover" bindtap="goHome" aria-role="button">
          <text>进入工作台</text>
        </view>
        <block wx:else>
          <button class="cta-btn cta-active {{uploading ? 'cta-busy' : ''}}" hover-class="cta-hover"
                  open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{uploading}}">
            <ui-icon name="wechat" color="#FFFFFF" size="20" />
            <text>{{uploading ? '上传中…' : '使用微信头像'}}</text>
          </button>
          <view class="skip-btn" hover-class="cta-hover" bindtap="goHome" aria-role="button">暂不设置，直接进入</view>
        </block>
      </view>
    </block>
  </view>

  <!-- 辅助说明条 -->
  <view wx:if="{{step === 'login'}}" class="help-card">
    <view class="help-icon"><ui-icon name="wx-info" color="#8E8E93" size="17" /></view>
    <view class="help-body">
      <view class="help-title">忘记密码怎么办？</view>
      <view class="help-desc">请联系售后主管在电脑后台重置密码，登录后可在「我的」里自己修改。</view>
    </view>
  </view>

  <!-- 底部品牌落款 -->
  <view class="login-footer">
    <view class="footer-line"></view>
    <text class="footer-text">HTLAB · 霍桐仪器售后服务平台</text>
    <view class="footer-line"></view>
  </view>
</view>
