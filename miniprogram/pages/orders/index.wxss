/* pages/orders：工单大厅（05）/ 全部工单（12） */
.head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24rpx; padding: 0 8rpx; }
.head-plain { padding: 0 8rpx; }

.new-btn { flex-shrink: 0; height: 72rpx; padding: 0 28rpx 0 20rpx; border-radius: 36rpx; background: var(--text); color: #FFFFFF; display: inline-flex; align-items: center; gap: 8rpx; font-size: 28rpx; font-weight: 600; margin-bottom: 4rpx; }

/* 卡片 */
.order-card { padding: 28rpx 32rpx; }
.list-card { padding: 26rpx 32rpx; }
.card-hover { opacity: 0.85; }
.customer { font-size: 32rpx; font-weight: 600; line-height: 44rpx; min-width: 0; }
.price { margin-left: auto; flex-shrink: 0; font-size: 36rpx; color: var(--text); }
.price-sm { font-size: 34rpx; }
.price.free-green { color: var(--green); }
.price.unpriced { font-size: 28rpx; font-weight: 600; color: var(--text-3); }
.pending-tag { background: #FBF3E4; }
.transfer-tag { background: var(--soft); color: var(--gray); }
.meta-hold { color: #8E8E93; }
.assist { flex-shrink: 0; font-size: 24rpx; color: var(--text-2); }
.device { font-size: 26rpx; color: var(--text-2); margin-top: 4rpx; }
.fault { font-size: 30rpx; line-height: 44rpx; margin-top: 16rpx; color: var(--text); }
.card-foot { margin-top: 20rpx; }
.meta { font-size: 26rpx; color: var(--text-2); }
.claim-btn { margin-left: auto; flex-shrink: 0; height: 72rpx; padding: 0 36rpx; border-radius: 20rpx; background: var(--text); color: #FFFFFF; font-size: 28rpx; font-weight: 600; display: inline-flex; align-items: center; }
.list-foot { margin-top: 16rpx; }
.meta-body { font-size: 26rpx; color: var(--text-body); min-width: 0; }

/* 搜索框 */
.search { margin-top: 28rpx; height: 84rpx; border-radius: 24rpx; background: var(--card); box-shadow: inset 0 0 0 2rpx var(--border); display: flex; align-items: center; gap: 16rpx; padding: 0 24rpx; }
.search-input { flex: 1; min-width: 0; height: 84rpx; font-size: 30rpx; color: var(--text); }
.search-clear { flex-shrink: 0; width: 56rpx; height: 56rpx; margin-right: -12rpx; display: flex; align-items: center; justify-content: center; }

/* 横向滚动筛选：贴边滚动 */
.chips-bleed { margin: 0 -32rpx; width: calc(100% + 64rpx); white-space: nowrap; }
.chips-track { display: inline-flex; padding: 24rpx 0 24rpx 32rpx; }
.chips-end { display: inline-block; width: 16rpx; flex-shrink: 0; }

/* 状态 */
.state { padding: 80rpx 0; text-align: center; font-size: 28rpx; color: var(--text-3); }
.load-more { padding: 24rpx 0 8rpx; text-align: center; font-size: 24rpx; color: var(--text-3); }
