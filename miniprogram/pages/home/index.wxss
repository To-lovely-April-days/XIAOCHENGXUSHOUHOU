/* pages/home：页头（原型 header 56px，头像 36px） */
.head { display: flex; align-items: center; box-sizing: border-box; }
.head-user { display: flex; align-items: center; gap: 20rpx; min-height: 88rpx; min-width: 0; }
.head-hover { opacity: 0.7; }
.head-avatar { display: flex; border-radius: 50%; box-shadow: 0 0 0 4rpx #FFFFFF; flex-shrink: 0; }
.head-text { min-width: 0; }
.head-name { font-size: 30rpx; font-weight: 600; line-height: 40rpx; color: #1D1D1F; }
.head-sub { font-size: 24rpx; color: #6E6E73; line-height: 34rpx; }
.state { padding: 160rpx 0; text-align: center; font-size: 28rpx; color: #6E6E73; }

/* v1.4 开启工单提醒提示条 */
.sub-tip { display: flex; align-items: center; gap: 16rpx; margin: 8rpx 0 16rpx; padding: 16rpx 8rpx 16rpx 24rpx; border-radius: 24rpx; background: #FFFFFF; box-shadow: inset 0 0 0 2rpx #E3E3E1; }
.sub-tip-icon { display: flex; flex-shrink: 0; }
.sub-tip-text { flex: 1; min-width: 0; font-size: 26rpx; line-height: 36rpx; color: #3A3A3C; }
.sub-tip-btn { flex-shrink: 0; height: 56rpx; padding: 0 24rpx; border-radius: 28rpx; background: #1D1D1F; color: #FFFFFF; font-size: 26rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; white-space: nowrap; }
.sub-tip-close { flex-shrink: 0; width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
