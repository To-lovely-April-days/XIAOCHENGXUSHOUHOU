/* pages/factory-node 返厂节点记录 / 更正（样式沿用 pages/complete） */
.fn-state { padding: 200rpx 0; text-align: center; font-size: 28rpx; }

.fn-notice {
  margin: 8rpx 0 24rpx; padding: 20rpx 28rpx; border-radius: 24rpx;
  background: var(--card); box-shadow: inset 0 0 0 2rpx var(--border);
  color: var(--text-body); font-size: 28rpx; line-height: 42rpx;
}

.fn-order { display: flex; align-items: center; gap: 16rpx; margin: 0 4rpx 20rpx; font-size: 26rpx; color: var(--text-2); }
.fn-order-name { font-weight: 600; color: var(--text); }
.fn-order-no { flex-shrink: 0; font-weight: 500; }

.fn-warn {
  display: flex; align-items: center; gap: 12rpx;
  margin-bottom: 24rpx; padding: 20rpx 28rpx; border-radius: 24rpx;
  background: var(--soft); color: var(--amber); font-size: 26rpx; line-height: 38rpx; font-weight: 600;
}
.fn-warn.gray { color: var(--gray); font-weight: 500; }

.fn-card {
  background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow);
  padding: 0 32rpx 8rpx;
}
.fn-mt { margin-top: 24rpx; }

.fn-label { font-size: 26rpx; font-weight: 600; color: var(--text-2); }
.fn-field { padding-top: 24rpx; border-bottom: 2rpx solid var(--divider); }
.fn-field-last { border-bottom: none; }
.fn-input { display: block; width: 100%; height: 88rpx; font-size: 32rpx; color: var(--text); }
.fn-textarea {
  display: block; width: 100%; min-height: 96rpx;
  margin: 12rpx 0 20rpx; padding: 0;
  font-size: 32rpx; line-height: 48rpx; color: var(--text);
}

.fn-chips { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 4rpx 0 24rpx; }
.fn-chip {
  height: 60rpx; padding: 0 24rpx; border-radius: 30rpx; display: inline-flex; align-items: center;
  background: var(--card); box-shadow: inset 0 0 0 2rpx var(--border); font-size: 26rpx; font-weight: 600; color: var(--text);
}
.fn-chip.on { background: var(--text); color: #FFFFFF; box-shadow: none; }
.fn-scan {
  flex-shrink: 0; height: 64rpx; padding: 0 28rpx; border-radius: 32rpx; margin-left: 16rpx;
  display: inline-flex; align-items: center; background: var(--soft); font-size: 26rpx; font-weight: 600; color: var(--text);
}

.fn-photo-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; padding: 24rpx 0 16rpx; }
.fn-photo-tip { font-size: 24rpx; color: var(--text-2); }
.fn-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16rpx; padding-bottom: 24rpx; }
.fn-thumb { position: relative; height: 144rpx; border-radius: 20rpx; overflow: hidden; background: var(--soft); }
.fn-thumb-img { width: 100%; height: 100%; display: block; }
.fn-thumb-mask {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
  background: rgba(0, 0, 0, 0.45); color: #FFFFFF; font-size: 22rpx; line-height: 32rpx;
}
.fn-thumb-mask.fail { background: rgba(200, 30, 43, 0.7); }
.fn-thumb-del {
  position: absolute; top: 6rpx; right: 6rpx; width: 40rpx; height: 40rpx; border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.55); display: flex; align-items: center; justify-content: center;
}
.fn-add {
  height: 144rpx; border-radius: 20rpx; border: 3rpx dashed var(--disabled); background: #FAFAF9;
  display: flex; align-items: center; justify-content: center;
}

.fn-submit { height: 100rpx; border-radius: 24rpx; font-size: 32rpx; }
