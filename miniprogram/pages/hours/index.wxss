/* pages/hours（原型 04） */
.hours { padding: 0; }
.head { display: flex; align-items: center; padding-left: 40rpx; }
.head-title { font-size: 44rpx; font-weight: 700; color: var(--text); }
.body { padding: 0 32rpx; margin-top: 8rpx; }
.state { padding: 120rpx 0; text-align: center; font-size: 28rpx; color: var(--text-3); }
.seg { margin: 8rpx 32rpx 0; }

/* 按天 */
.today { display: flex; align-items: center; gap: 40rpx; padding: 32rpx 40rpx 24rpx; }
.clock { width: 280rpx; height: 280rpx; flex-shrink: 0; }
.today-info { min-width: 0; }
.today-date { font-size: 26rpx; color: var(--text-2); }
.today-total { font-family: var(--font-num); font-variant-numeric: tabular-nums; font-size: 96rpx; line-height: 108rpx; font-weight: 600; color: var(--text); }
.today-ss { font-size: 40rpx; font-weight: 600; color: var(--text-2); margin-left: 2rpx; }
.today-state { margin-top: 12rpx; font-size: 26rpx; color: var(--text-body); display: flex; align-items: center; gap: 12rpx; }
.today-state .dot { width: 16rpx; height: 16rpx; }

.entry { padding: 32rpx; }
.entry-hover { opacity: 0.85; }
.entry-top { display: flex; align-items: baseline; gap: 16rpx; }
.entry-name { flex: 1; min-width: 0; font-size: 32rpx; font-weight: 600; }
.entry-dur { font-family: var(--font-num); font-variant-numeric: tabular-nums; font-size: 36rpx; font-weight: 700; color: var(--text); }
.entry-sub { margin-top: 4rpx; font-size: 26rpx; color: var(--text-2); font-family: var(--font-num); font-variant-numeric: tabular-nums; }
.pair { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-top: 24rpx; }
.side { min-width: 0; }
.shot { position: relative; height: 152rpx; border-radius: 20rpx; overflow: hidden; background: linear-gradient(135deg, #3B4250, #23272F); }
.shot-img { width: 100%; height: 100%; display: block; }
.shot-label { position: absolute; left: 16rpx; bottom: 12rpx; font-size: 24rpx; font-weight: 600; color: #FFFFFF; font-family: var(--font-num); font-variant-numeric: tabular-nums; text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.5); }
.shot-empty { background: var(--soft); display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 600; color: var(--text-body); font-family: var(--font-num); }
.shot-wait { background: transparent; border: 3rpx dashed #D1D1CF; display: flex; align-items: center; justify-content: center; font-size: 26rpx; color: var(--text-2); }
.side-note { margin-top: 8rpx; font-size: 24rpx; color: var(--text-2); line-height: 34rpx; }

.leave-btn { margin-top: 24rpx; height: 100rpx; border-radius: 24rpx; background: var(--red); color: #FFFFFF; display: flex; align-items: center; justify-content: center; gap: 16rpx; font-size: 32rpx; font-weight: 600; box-shadow: 0 8rpx 24rpx rgba(200, 30, 43, 0.22); }
.tip { margin: 20rpx 8rpx 0; font-size: 26rpx; line-height: 40rpx; color: var(--text-2); }
.tip-sm { font-size: 24rpx; line-height: 36rpx; }

/* 按月 */
.month-head { padding: 28rpx 40rpx 24rpx; }
.month-switch { display: flex; align-items: center; gap: 12rpx; }
.month-label { font-size: 26rpx; color: var(--text-2); }
.arrow { width: 52rpx; height: 52rpx; border-radius: 26rpx; background: var(--card); box-shadow: inset 0 0 0 2rpx var(--border); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.arrow-off { background: transparent; }
.month-sum { display: flex; align-items: flex-end; gap: 48rpx; margin-top: 4rpx; }
.month-total { font-family: var(--font-num); font-variant-numeric: tabular-nums; font-size: 88rpx; line-height: 100rpx; font-weight: 600; }
.month-days { padding-bottom: 8rpx; }
.month-days-num { font-family: var(--font-num); font-variant-numeric: tabular-nums; font-size: 44rpx; font-weight: 600; }
.month-days-label { font-size: 24rpx; color: var(--text-2); }

.calendar { padding: 0 40rpx; }
.cal-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 8rpx; }
.cal-head { text-align: center; font-size: 22rpx; color: var(--text-2); padding-bottom: 4rpx; }
.cal-cell { position: relative; height: 52rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; font-family: var(--font-num); font-variant-numeric: tabular-nums; font-size: 24rpx; font-weight: 600; }
.cal-blank { background: transparent; }
.cal-today { box-shadow: 0 0 0 4rpx var(--text); }
.cal-dot { position: absolute; bottom: 6rpx; left: 50%; margin-left: -4rpx; width: 8rpx; height: 8rpx; border-radius: 4rpx; background: #D18A00; }
.legend { margin-top: 16rpx; display: flex; gap: 28rpx; font-size: 22rpx; color: var(--text-2); }
.legend-item { display: inline-flex; align-items: center; gap: 12rpx; }
.legend-dot { width: 16rpx; height: 16rpx; border-radius: 8rpx; }
.calendar + .body { margin-top: 24rpx; }

.day-list { padding: 0 32rpx; }
.day-row { display: flex; align-items: center; gap: 28rpx; padding: 22rpx 0; border-bottom: 2rpx solid var(--divider); }
.day-row:last-child { border-bottom: none; }
.day-date { width: 72rpx; flex-shrink: 0; text-align: center; display: flex; flex-direction: column; }
.day-week { font-size: 22rpx; color: var(--text-2); }
.day-num { font-family: var(--font-num); font-variant-numeric: tabular-nums; font-size: 38rpx; line-height: 44rpx; font-weight: 700; }
.day-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.day-customer { font-size: 30rpx; font-weight: 600; }
.day-note { margin-top: 2rpx; font-size: 24rpx; color: var(--text-2); font-family: var(--font-num); font-variant-numeric: tabular-nums; }
.day-note.red { color: var(--red); }
.day-note.amber { color: var(--amber); }
.day-dur { font-family: var(--font-num); font-variant-numeric: tabular-nums; font-size: 34rpx; font-weight: 700; color: var(--text); flex-shrink: 0; }

/* v1.1：协助标签 */
.assist-tag { background: var(--soft); color: var(--gray); align-self: center; }
.day-assist { font-size: 24rpx; font-weight: 500; color: var(--text-2); }
