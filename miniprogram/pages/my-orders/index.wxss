/* pages/my-orders（原型 10） */
.desc { padding: 0 8rpx; font-size: 28rpx; color: var(--text-2); }

.row-card { padding: 28rpx 32rpx; }
.card-hover { opacity: 0.85; }
.customer { font-size: 32rpx; font-weight: 600; line-height: 44rpx; min-width: 0; }
.assist-tag { background: var(--soft); color: var(--gray); }
.note-hold { color: #8E8E93; }
.device { font-size: 26rpx; color: var(--text-2); margin-top: 4rpx; }
.foot { margin-top: 20rpx; font-size: 26rpx; color: var(--text-body); }
.note { flex: 1; min-width: 0; font-family: var(--font-num); font-variant-numeric: tabular-nums; }
.hours { flex-shrink: 0; text-align: right; }
.hours-label { font-size: 22rpx; color: var(--text-2); line-height: 30rpx; }
.hours-value { font-size: 32rpx; color: var(--text); line-height: 40rpx; }

.state { padding: 80rpx 0; text-align: center; font-size: 28rpx; color: var(--text-3); }
.tip { margin: 8rpx 8rpx 0; padding-top: 12rpx; font-size: 26rpx; line-height: 40rpx; color: var(--text-2); }

/* v1.3 筛选横向滚动：贴边滚动（同 pages/orders） */
.chips-bleed { margin: 0 -32rpx; width: calc(100% + 64rpx); white-space: nowrap; }
.chips-track { display: inline-flex; padding: 24rpx 0 24rpx 32rpx; }
.chips-end { display: inline-block; width: 16rpx; flex-shrink: 0; }
