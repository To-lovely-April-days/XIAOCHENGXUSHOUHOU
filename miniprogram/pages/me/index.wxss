/* pages/me（原型 09） */
.me { padding: 0; }
.num-font { font-family: var(--font-num); font-variant-numeric: tabular-nums; }

.profile { display: flex; align-items: center; gap: 32rpx; padding: 8rpx 40rpx 0; }
.avatar-btn { position: relative; flex-shrink: 0; width: 128rpx !important; height: 128rpx; border-radius: 50%; box-shadow: 0 0 0 4rpx #FFFFFF; overflow: visible; }
.avatar-edit { position: absolute; right: -4rpx; bottom: -4rpx; width: 40rpx; height: 40rpx; border-radius: 50%; background: var(--text); border: 4rpx solid var(--bg); display: flex; align-items: center; justify-content: center; }
.profile-info { flex: 1; min-width: 0; }
.name-row { gap: 16rpx; }
.name { font-size: 48rpx; line-height: 64rpx; font-weight: 700; min-width: 0; }
.role-tag { flex-shrink: 0; height: 44rpx; padding: 0 16rpx; border-radius: 12rpx; background: var(--divider); color: var(--text-body); font-size: 24rpx; font-weight: 600; display: inline-flex; align-items: center; }
.subline { margin-top: 4rpx; font-size: 28rpx; color: var(--text-2); }

.stats { display: grid; margin: 40rpx 40rpx 0; text-align: center; }
.stat { padding: 4rpx 0; }
.stat-value { font-family: var(--font-num); font-variant-numeric: tabular-nums; font-size: 44rpx; font-weight: 600; color: var(--text); }
.stat-label { margin-top: 4rpx; font-size: 24rpx; color: var(--text-2); }

.load-error { margin: 20rpx 40rpx 0; font-size: 26rpx; color: var(--red); text-align: center; }

.me .menu { margin: 24rpx 32rpx 0; padding: 0 32rpx; }
.stats + .menu { margin-top: 40rpx; }
.menu-item { min-height: 112rpx; display: flex; align-items: center; gap: 20rpx; border-bottom: 2rpx solid var(--divider); color: var(--text); }
.menu-item:last-child { border-bottom: none; }
.menu-btn { width: 100% !important; text-align: left; border-radius: 0; }
.menu-text { flex: 1; font-size: 32rpx; }
.menu-extra { font-size: 28rpx; color: var(--text-2); }
.menu-hover { background: var(--bg); }

.foot-note { margin: 24rpx 40rpx 0; font-size: 26rpx; line-height: 40rpx; color: var(--text-2); }
.logout-btn { margin: 40rpx 32rpx 0; height: 88rpx; border-radius: var(--radius-btn); display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: var(--red); background: var(--card); box-shadow: inset 0 0 0 2rpx var(--border); }
