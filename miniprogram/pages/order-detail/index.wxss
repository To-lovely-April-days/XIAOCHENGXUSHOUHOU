/* pages/order-detail（原型 06 / 13，1px = 2rpx） */
.od { padding-top: 8rpx; }
.num-font { font-family: var(--font-num); font-variant-numeric: tabular-nums; }
.od-state { padding: 200rpx 0; text-align: center; font-size: 28rpx; }
.od-state-wrap { padding-top: 48rpx; }

/* 头部卡片 */
.od-head { background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow); padding: 32rpx; }
.od-head-top { gap: 20rpx; }
.od-no { font-size: 26rpx; color: var(--text-2); }
.od-customer { margin-top: 16rpx; font-size: 44rpx; line-height: 60rpx; font-weight: 700; word-break: break-all; }
.od-device { margin-top: 4rpx; font-size: 28rpx; color: var(--text-2); word-break: break-all; }
.od-grid { display: flex; gap: 16rpx; margin-top: 28rpx; padding-top: 24rpx; border-top: 2rpx solid var(--divider); }
.od-cell { flex: 1; min-width: 0; }
.od-cell-label { font-size: 24rpx; color: var(--text-2); }
.od-cell-num { margin-top: 4rpx; font-family: var(--font-num); font-variant-numeric: tabular-nums; font-size: 36rpx; font-weight: 700; line-height: 48rpx; }
.od-cell-text { margin-top: 6rpx; font-size: 32rpx; font-weight: 600; line-height: 44rpx; }
.od-creator { gap: 12rpx; margin-top: 6rpx; }
.od-creator-name { font-size: 32rpx; font-weight: 600; line-height: 44rpx; }

.od-assignee { gap: 24rpx; margin-top: 24rpx; padding-top: 24rpx; border-top: 2rpx solid var(--divider); }
.od-assignee-name { font-size: 32rpx; font-weight: 600; }
.od-assignee-role { font-size: 26rpx; font-weight: 400; color: var(--text-2); }
.od-assignee-sub { margin-top: 2rpx; font-size: 26rpx; color: var(--text-2); }
.od-assignee-none { font-size: 28rpx; padding: 8rpx 0; }

/* 异常警示 */
.od-alert { margin-top: 24rpx; border-radius: 24rpx; padding: 24rpx 28rpx; }
.od-alert.red { background: var(--red-soft); color: var(--red); }
.od-alert.amber { background: var(--soft); color: var(--amber); }
.od-alert-head { gap: 12rpx; }
.od-alert-title { font-size: 28rpx; font-weight: 700; }
.od-alert-text { margin-top: 8rpx; font-size: 26rpx; line-height: 40rpx; }
.od-alert-btn { display: flex; align-items: center; justify-content: center; margin-top: 20rpx; height: 76rpx; border-radius: 16rpx; background: var(--text); color: #FFFFFF; font-size: 28rpx; font-weight: 600; }
.od-supp { margin-top: 20rpx; background: var(--card); border-radius: 20rpx; padding: 20rpx 24rpx; color: var(--text); }
.od-supp-hint { font-size: 24rpx; color: var(--text-2); margin-bottom: 8rpx; }
.od-supp-field { height: 88rpx; border-bottom: 2rpx solid var(--divider); font-size: 30rpx; }
.od-supp-label { font-size: 28rpx; color: var(--text-2); }
.od-supp-label-top { margin-top: 20rpx; }
.od-supp-input { width: 100%; min-height: 120rpx; margin-top: 12rpx; padding: 20rpx 24rpx; border-radius: 16rpx; background: var(--bg); font-size: 28rpx; line-height: 40rpx; box-sizing: border-box; }
.od-supp-actions { gap: 20rpx; margin-top: 20rpx; }
.od-supp-save { flex: 2; height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: var(--text); color: #FFFFFF; font-size: 28rpx; font-weight: 600; }
.od-supp-save.disabled { background: var(--disabled); }
.od-supp-cancel { flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: var(--soft); color: var(--text); font-size: 28rpx; font-weight: 600; }
.od-supp-note { margin-top: 16rpx; font-size: 24rpx; color: var(--text-3); }

/* tabs */
.od-tabs { margin-top: 24rpx; }
.od-main { padding-top: 24rpx; }

/* 通用卡片 */
.od-card { background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow); padding: 0 32rpx 8rpx; }
.mt-card { margin-top: 24rpx; }
.od-h3 { padding: 28rpx 0 8rpx; font-size: 26rpx; font-weight: 600; color: var(--text-2); }
.od-quote { margin-bottom: 8rpx; font-size: 32rpx; line-height: 48rpx; word-break: break-all; }
.od-kv { display: flex; justify-content: space-between; gap: 32rpx; padding: 24rpx 0; border-top: 2rpx solid var(--divider); font-size: 30rpx; line-height: 42rpx; }
.od-kv.first { border-top: none; }
.od-kv-label { flex-shrink: 0; color: var(--text-2); }
.od-kv-value { flex: 1; min-width: 0; text-align: right; word-break: break-all; }
.od-empty-line { padding: 40rpx 0; text-align: center; font-size: 28rpx; }

/* 客户 */
.od-contact { gap: 24rpx; padding: 12rpx 0 20rpx; border-bottom: 2rpx solid var(--divider); }
.od-contact-name { font-size: 32rpx; font-weight: 600; }
.od-contact-phone { font-size: 28rpx; color: var(--text-2); }
.od-addr { gap: 24rpx; padding: 20rpx 0; }
.od-addr-text { font-size: 30rpx; line-height: 44rpx; word-break: break-all; }
.od-circle { width: 88rpx; height: 88rpx; border-radius: 44rpx; background: var(--soft); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

/* 竖向时间线（共用） */
.od-rail { display: flex; flex-direction: column; align-items: center; }

/* 进度 */
.od-progress { padding: 24rpx 32rpx 8rpx; }
.od-step { display: flex; gap: 24rpx; }
.od-step .od-rail { width: 32rpx; flex-shrink: 0; }
.od-step-dot { width: 20rpx; height: 20rpx; border-radius: 10rpx; margin-top: 12rpx; flex-shrink: 0; background: var(--text); box-sizing: border-box; }
.od-step-dot.current { background: var(--red); }
.od-step-dot.future { background: #FFFFFF; border: 4rpx solid var(--disabled); }
.od-step-line { flex: 1; width: 4rpx; margin-top: 6rpx; background: var(--track); }
.od-step-line.on { background: var(--text); }
.od-step-body { flex: 1; min-width: 0; padding-bottom: 18rpx; }
.od-step-title { font-size: 30rpx; line-height: 42rpx; font-weight: 600; }
.od-step-sub { font-size: 24rpx; line-height: 34rpx; color: var(--text-2); }
.od-step-sub.red { color: var(--red); }
.od-step-sub.amber { color: var(--amber); }
.od-step-tag { flex-shrink: 0; font-size: 24rpx; line-height: 42rpx; font-weight: 600; }
.od-note { margin: 20rpx 8rpx 0; font-size: 24rpx; line-height: 36rpx; color: var(--text-2); }

/* 打卡记录 */
.od-day { padding: 0 32rpx; }
.od-day-head { display: flex; align-items: center; gap: 16rpx; padding: 28rpx 0; }
.od-day-title { font-size: 32rpx; font-weight: 600; }
.od-day-sub { margin-top: 4rpx; font-size: 26rpx; color: var(--text-2); }
.od-day-running { font-size: 28rpx; font-weight: 600; color: var(--red); }
.od-day-dur { font-size: 36rpx; font-weight: 700; }
.od-day-arrow { transition: transform 0.2s; display: flex; }
.od-day-arrow.open { transform: rotate(180deg); }
.od-day-body { padding-bottom: 12rpx; }
.od-entry { display: flex; gap: 24rpx; }
.od-entry .od-rail { width: 32rpx; flex-shrink: 0; }
.od-entry-dot { width: 20rpx; height: 20rpx; border-radius: 10rpx; margin-top: 12rpx; flex-shrink: 0; background: var(--text); box-sizing: border-box; }
.od-entry-dot.gray { background: var(--disabled); }
.od-entry-dot.amber { background: var(--amber); }
.od-entry-dot.missing { background: #FFFFFF; border: 3rpx dashed var(--red); }
.od-entry-line { flex: 1; width: 4rpx; margin-top: 8rpx; background: var(--track); }
.od-entry-body { flex: 1; min-width: 0; padding-bottom: 28rpx; }
.od-entry-kind { font-size: 32rpx; font-weight: 600; }
.od-entry-time { font-size: 28rpx; font-weight: 500; color: var(--text-2); }
.od-entry-note { margin-top: 4rpx; font-size: 26rpx; line-height: 38rpx; color: var(--text-2); }
.od-entry-note.red { color: var(--red); }
.od-entry-note.amber { color: var(--amber); }
.od-entry-side { display: flex; align-items: flex-start; gap: 16rpx; flex-shrink: 0; }
.od-entry-dur { font-size: 28rpx; font-weight: 600; line-height: 44rpx; }
.od-thumb { width: 88rpx; height: 88rpx; border-radius: 12rpx; background: var(--track); }

/* 资料 */
.od-files { padding: 0 32rpx; }
.od-file { display: flex; align-items: center; gap: 24rpx; min-height: 128rpx; border-bottom: 2rpx solid var(--divider); }
.od-file:last-child { border-bottom: none; }
.od-file-hover { opacity: 0.7; }
.od-file-title { font-size: 32rpx; font-weight: 600; }
.od-file-desc { margin-top: 4rpx; font-size: 26rpx; color: var(--text-2); }
.od-file-count { font-size: 28rpx; font-weight: 600; color: var(--text-2); }
.od-file-count.amber { color: var(--amber); }

/* 底部按钮 */
.od-footer { gap: 20rpx; }
.od-btn { flex: 1; height: 100rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 600; }
.od-btn.wide { flex: 2; }
.od-btn.secondary { background: var(--soft); color: var(--text); }
.od-btn.primary { background: var(--text); color: #FFFFFF; }
.od-btn.disabled { background: var(--disabled); color: #FFFFFF; }

/* 预约弹层 */
.od-appt-head { margin-top: 28rpx; }
.od-appt-title { font-size: 36rpx; font-weight: 700; }
.od-appt-cancel { font-size: 30rpx; padding: 8rpx 0 8rpx 24rpx; }
.od-appt-sub { margin-top: 8rpx; margin-bottom: 8rpx; font-size: 26rpx; }
.od-appt-btn { margin-top: 48rpx; }

/* ========== v1.1 ========== */
/* 头部：进度条 / 价格 */
.od-pb { margin-top: 28rpx; }
.od-cell-link { margin-left: 12rpx; font-size: 24rpx; font-weight: 600; color: var(--text); text-decoration: underline; }
.od-cell-num.unpriced { font-family: inherit; font-size: 32rpx; font-weight: 600; }
.od-suggest { display: flex; align-items: center; gap: 16rpx; margin-top: 24rpx; padding: 18rpx 24rpx; border-radius: 20rpx; background: var(--bg); font-size: 26rpx; line-height: 38rpx; color: var(--text-body); }
.od-suggest.amber { background: #FBF3E4; color: var(--amber); font-weight: 600; }
.od-suggest-text { min-width: 0; word-break: break-all; }
.od-suggest-note { font-weight: 400; }
.od-suggest-tag { background: #FBF3E4; }
.od-suggest-go { flex-shrink: 0; font-size: 26rpx; font-weight: 600; color: var(--text); text-decoration: underline; }
.od-link { flex-shrink: 0; font-size: 26rpx; font-weight: 600; color: var(--text); text-decoration: underline; padding: 4rpx 0 4rpx 16rpx; }

/* 申请卡片（琥珀色） */
.od-req { margin-top: 24rpx; border-radius: 24rpx; padding: 24rpx 28rpx; background: #FBF3E4; color: var(--amber); }
.od-req-title { font-size: 28rpx; font-weight: 700; }
.od-req-time { font-size: 24rpx; opacity: 0.85; }
.od-req-text { margin-top: 8rpx; font-size: 28rpx; line-height: 42rpx; color: var(--text); word-break: break-all; }
.od-req-actions { gap: 20rpx; margin-top: 20rpx; }
.od-req-btn { flex: 1; height: 76rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; background: #FFFFFF; color: var(--text); font-size: 28rpx; font-weight: 600; }
.od-req-btn.primary { flex: 2; background: var(--text); color: #FFFFFF; }
.od-req-btn.primary.disabled { background: var(--disabled); }
.od-req-btn.small { flex: none; height: 64rpx; padding: 0 32rpx; }
.od-req-wait { font-size: 26rpx; }
.od-req-wait-top { margin-top: 12rpx; }
.od-req-rejected { margin-top: 24rpx; padding: 20rpx 28rpx; border-radius: 24rpx; background: var(--soft); font-size: 26rpx; line-height: 40rpx; color: var(--text-body); }

/* 暂停提示条（灰色） */
.od-holdbar { display: flex; align-items: center; gap: 20rpx; margin-bottom: 24rpx; padding: 24rpx 28rpx; border-radius: 24rpx; background: #ECECEA; color: var(--gray); }
.od-holdbar-mark { width: 52rpx; height: 52rpx; border-radius: 26rpx; background: #AEAEB2; display: flex; align-items: center; justify-content: center; gap: 8rpx; flex-shrink: 0; }
.od-holdbar-bar { width: 6rpx; height: 20rpx; border-radius: 3rpx; background: #FFFFFF; }
.od-holdbar-text { font-size: 28rpx; font-weight: 700; line-height: 40rpx; word-break: break-all; }
.od-holdbar-sub { margin-top: 2rpx; font-size: 24rpx; line-height: 36rpx; }
.od-step-dot.paused { background: #AEAEB2; }
.od-step-title.paused { color: var(--gray); }
.od-hint-line { margin-bottom: 24rpx; padding: 20rpx 28rpx; border-radius: 24rpx; background: var(--soft); font-size: 26rpx; line-height: 38rpx; color: var(--amber); font-weight: 600; }
.od-hint-line.mt-card { margin-top: 24rpx; }

/* 处理人员 */
.od-person { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 0; border-top: 2rpx solid var(--divider); }
.od-person.first { border-top: none; }
.od-person-main { gap: 12rpx; min-width: 0; }
.od-person-name { font-size: 30rpx; font-weight: 600; min-width: 0; }
.od-role { background: var(--soft); color: var(--gray); }
.od-role.lead { background: var(--text); color: #FFFFFF; }
.od-role.former { color: var(--text-3); }
.od-person-flag { flex-shrink: 0; font-size: 24rpx; font-weight: 600; color: var(--red); }
.od-person-hours { flex-shrink: 0; font-size: 32rpx; font-weight: 700; }

/* 返厂流程时间线（沿用进度时间线） */
.od-factory { padding-bottom: 8rpx; }
.od-factory .od-h3 { padding-bottom: 16rpx; }
.od-step-dot.f-done { background: var(--text); }
.od-step-dot.f-current { background: var(--red); }
.od-step-dot.f-todo, .od-step-dot.f-skipped { background: #FFFFFF; border: 4rpx solid var(--disabled); }
.od-fnode-body { padding-bottom: 28rpx; }
.od-fnode-head { gap: 12rpx; }
.od-fnode-skip { background: var(--soft); color: var(--text-3); }
.od-track { display: inline-flex; align-items: center; gap: 12rpx; max-width: 100%; margin-top: 12rpx; padding: 12rpx 20rpx; border-radius: 16rpx; background: var(--bg); font-size: 28rpx; }
.od-track-courier { flex-shrink: 0; color: var(--text-2); }
.od-track-no { min-width: 0; font-weight: 600; word-break: break-all; }
.od-track-copy { flex-shrink: 0; font-size: 24rpx; color: var(--text-2); text-decoration: underline; }
.od-fnode-note { margin-top: 8rpx; font-size: 26rpx; line-height: 38rpx; color: var(--text-body); word-break: break-all; }
.od-fnode-photos { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.od-fnode-btn { display: flex; align-items: center; justify-content: center; margin-top: 16rpx; height: 76rpx; border-radius: 16rpx; background: var(--text); color: #FFFFFF; font-size: 28rpx; font-weight: 600; }

/* 底部弹层：暂停 / 定价 */
.od-sheet-label { margin-top: 28rpx; font-size: 26rpx; font-weight: 600; color: var(--text-2); }
.od-sheet-opt { font-weight: 400; color: var(--text-3); }
.od-reasons { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.od-reason { margin-right: 0; }
.od-sheet-input { margin-top: 16rpx; height: 92rpx; padding: 0 28rpx; border-radius: 20rpx; background: var(--bg); font-size: 30rpx; color: var(--text); }
.od-adopt { gap: 16rpx; margin-top: 20rpx; padding: 18rpx 24rpx; border-radius: 20rpx; background: #FBF3E4; }
.od-adopt-text { min-width: 0; font-size: 26rpx; line-height: 38rpx; color: var(--amber); font-weight: 600; word-break: break-all; }
.od-adopt-btn { flex-shrink: 0; height: 60rpx; padding: 0 24rpx; border-radius: 30rpx; background: var(--text); color: #FFFFFF; font-size: 26rpx; font-weight: 600; display: inline-flex; align-items: center; }
.od-amount { margin-top: 12rpx; min-height: 120rpx; border-bottom: 2rpx solid var(--divider); gap: 12rpx; }
.od-amount-label { margin-top: 0; }
.od-yen { font-size: 36rpx; font-weight: 600; color: var(--text-2); }
.od-amount-input { width: 280rpx; height: 96rpx; font-size: 44rpx; font-weight: 600; color: var(--text); text-align: right; font-family: var(--font-num); font-variant-numeric: tabular-nums; }

/* ========== v1.2 附件 ========== */
.od-atts { padding-bottom: 8rpx; }
.od-att { display: flex; align-items: center; gap: 24rpx; min-height: 128rpx; padding: 20rpx 0; border-top: 2rpx solid var(--divider); }
.od-att.first { border-top: none; }
.od-att-badge { flex-shrink: 0; width: 80rpx; height: 80rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; color: #FFFFFF; font-size: 24rpx; font-weight: 700; }
.od-att-badge.sm { width: 64rpx; height: 64rpx; border-radius: 14rpx; font-size: 22rpx; }
.od-att-name { font-size: 30rpx; line-height: 42rpx; font-weight: 600; }
.od-att-sub { margin-top: 2rpx; font-size: 24rpx; line-height: 34rpx; color: var(--text-2); }
.od-att-tags { display: flex; margin-top: 8rpx; }
.od-att-more { flex-shrink: 0; width: 72rpx; height: 72rpx; border-radius: 36rpx; display: flex; align-items: center; justify-content: center; }
.od-sub-title { margin: 36rpx 8rpx 16rpx; font-size: 26rpx; font-weight: 600; color: var(--text-2); }

/* 添加附件弹层 */
.od-att-switch { gap: 24rpx; margin-top: 16rpx; min-height: 112rpx; border-bottom: 2rpx solid var(--divider); }
.od-att-switch-title { font-size: 30rpx; font-weight: 600; }
.od-att-switch-sub { margin-top: 2rpx; font-size: 24rpx; color: var(--text-2); }
.od-att-picks { gap: 20rpx; margin-top: 28rpx; }
.od-att-pick { flex: 1; min-width: 0; height: 92rpx; border-radius: 20rpx; background: var(--soft); display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600; color: var(--text); }
.od-att-hint { margin-top: 20rpx; font-size: 24rpx; line-height: 36rpx; color: var(--text-2); }
.od-att-picked { margin-top: 16rpx; max-height: 34vh; }
.od-att-item { display: flex; align-items: center; gap: 20rpx; padding: 18rpx 0; border-top: 2rpx solid var(--divider); }
.od-att-item.first { border-top: none; }
.od-att-err { font-size: 24rpx; line-height: 34rpx; color: var(--red); word-break: break-all; }
.od-att-op { flex-shrink: 0; padding: 16rpx 0 16rpx 20rpx; font-size: 26rpx; font-weight: 600; color: var(--text); text-decoration: underline; }
.od-att-op.muted { color: var(--text-2); }
.od-att-btn { margin-top: 28rpx; }

/* ========== v1.3 ========== */
/* 已退出只读提示（灰色） */
.od-readonly { margin-top: 24rpx; padding: 20rpx 28rpx; border-radius: 24rpx; background: #ECECEA; font-size: 26rpx; line-height: 40rpx; color: var(--gray); }
/* 转交卡片（沿用 od-req） */
.od-req-reason { margin-top: 4rpx; font-size: 26rpx; line-height: 40rpx; color: var(--text-body); word-break: break-all; }
/* 设备资料 */
.od-dev-title { padding: 20rpx 0 4rpx; border-top: 2rpx solid var(--divider); font-size: 26rpx; font-weight: 600; color: var(--text-2); }
.od-dev-kv { padding: 8rpx 0; border-top: none; }
.od-dev-kv.last { padding-bottom: 20rpx; }
.od-kv-value.muted { color: var(--text-3); }
/* 处理人员：已转交 / 已改派 */
.od-person-exit { flex-shrink: 0; font-size: 24rpx; color: var(--text-3); }
/* 附件按类别分组 */
.od-att-group { display: flex; align-items: flex-start; gap: 16rpx; padding: 24rpx 0 4rpx; border-top: 2rpx solid var(--divider); }
.od-att-group.first { border-top: none; padding-top: 8rpx; }
.od-att-group-title { font-size: 28rpx; line-height: 40rpx; font-weight: 600; color: var(--text); word-break: break-all; }
.od-att-none { padding: 12rpx 0 24rpx; font-size: 26rpx; color: var(--text-3); }
.od-att-type-label { margin-top: 20rpx; }
/* 修改 SAT 信息弹层 */
.od-sat-row { margin-top: 20rpx; gap: 16rpx; }
.od-sat-pick { gap: 24rpx; min-height: 104rpx; }
.od-sat-label { flex-shrink: 0; font-size: 30rpx; color: var(--text-2); }
.od-sat-value { min-width: 0; text-align: right; font-size: 30rpx; color: var(--text); }
.od-sat-value.placeholder { color: var(--text-3); }
.od-sat-clear { flex-shrink: 0; padding: 16rpx 0 16rpx 8rpx; font-size: 26rpx; font-weight: 600; color: var(--text-2); text-decoration: underline; }
.od-sat-legacy { margin-top: 12rpx; font-size: 24rpx; line-height: 36rpx; color: var(--text-2); }
