<nav-bar title="工单详情" />

<view class="page od">
  <!-- 加载 / 错误 -->
  <view wx:if="{{loading && !order}}" class="od-state muted">加载中…</view>
  <view wx:elif="{{error && !order}}" class="od-state-wrap">
    <empty text="{{error}}" desc="请检查网络后重试">
      <view class="btn-secondary btn-sm" hover-class="btn-hover" bindtap="onRetry">重新加载</view>
    </empty>
  </view>

  <block wx:elif="{{order}}">
    <!-- 公共头部 -->
    <view class="od-head">
      <view class="row od-head-top">
        <status-tag status="{{order.status}}" />
        <urgency-tag urgency="{{order.urgency}}" size="md" />
        <text class="od-no num-font">{{order.orderNo}}</text>
      </view>
      <view class="od-customer">{{order.customerName}}</view>
      <view class="od-device">{{order.deviceText}}</view>

      <!-- 5 段进度（暂停时显示灰色暂停标记与原因） -->
      <view class="od-pb"><progress-bar order="{{order}}" labels="{{true}}" /></view>

      <view class="od-grid">
        <!-- 工程师不显示价格：第 1 格为维修类型 -->
        <view class="od-cell" wx:if="{{isEngineerView}}">
          <view class="od-cell-label">维修类型</view>
          <view class="od-cell-text">{{typeText || '—'}}</view>
        </view>
        <view class="od-cell" wx:else bindtap="onPriceLink">
          <view class="od-cell-label">服务价格<text wx:if="{{priceLink}}" class="od-cell-link">{{priceLink}}</text></view>
          <view class="od-cell-num {{priceClass}}">{{priceText}}</view>
        </view>
        <view class="od-cell" wx:if="{{isEngineerView}}">
          <view class="od-cell-label">产品阶段</view>
          <view class="od-cell-text">{{order.productStage || '—'}}</view>
        </view>
        <view class="od-cell" wx:else>
          <view class="od-cell-label">累计现场工时</view>
          <view class="od-cell-num">{{order.serviceType === 'Onsite' ? hoursText : '—'}}</view>
        </view>
        <view class="od-cell">
          <view class="od-cell-label">{{creatorLabel}}</view>
          <view class="row od-creator" wx:if="{{order.creator}}">
            <avatar user="{{order.creator}}" size="22" />
            <text class="od-creator-name ellipsis">{{order.creator.name}}</text>
          </view>
        </view>
      </view>

      <!-- 处理人（销售 / 主管视角） -->
      <view wx:if="{{!isEngineerView}}" class="od-assignee row">
        <block wx:if="{{order.assignee}}">
          <avatar user="{{order.assignee}}" size="40" />
          <view class="flex1">
            <view class="od-assignee-name">{{order.assignee.name}} <text class="od-assignee-role">· 处理人</text></view>
            <view class="od-assignee-sub num-font">{{assigneeSub}}</view>
          </view>
        </block>
        <view wx:else class="od-assignee-none muted">暂无处理人<text wx:if="{{order.status === 'Pending'}}">，等待认领或主管指派</text></view>
      </view>

      <!-- 价格建议（销售：我方建议；主管：待处理的建议，点击去定价） -->
      <view wx:if="{{!isEngineerView && suggestion}}" class="od-suggest {{suggestion.tone}}" bindtap="onSuggestionTap">
        <text class="flex1 od-suggest-text">{{suggestion.text}}<text wx:if="{{suggestion.note}}" class="od-suggest-note"> · {{suggestion.note}}</text></text>
        <text wx:if="{{suggestion.tag}}" class="tag tag-sm tag-amber od-suggest-tag">{{suggestion.tag}}</text>
        <text wx:if="{{suggestion.tappable}}" class="od-suggest-go">去定价</text>
      </view>
    </view>

    <!-- 只读提示（v1.3：当前用户已退出本单——已转交 / 已改派） -->
    <view wx:if="{{order.readOnlyText}}" class="od-readonly">{{order.readOnlyText}}</view>

    <!-- 异常警示 -->
    <view wx:for="{{issues}}" wx:key="key" class="od-alert {{item.tone}}">
      <view class="row od-alert-head">
        <ui-icon name="warning" color="{{item.tone === 'red' ? '#C81E2B' : '#9A5B00'}}" size="18" stroke="2" />
        <text class="od-alert-title">{{item.title}}</text>
      </view>
      <view class="od-alert-text">{{item.text}}</view>

      <block wx:if="{{item.canSupplement}}">
        <view wx:if="{{!(supp.open && supp.punchId === item.punchId)}}" class="od-alert-btn" hover-class="btn-hover" data-id="{{item.punchId}}" bindtap="openSupp">补录离场时间</view>
        <view wx:else class="od-supp">
          <view wx:if="{{supp.arriveText}}" class="od-supp-hint">对应 {{supp.arriveText}}，离场须晚于到场且同一天</view>
          <picker mode="time" value="{{supp.time || supp.minTime}}" start="{{supp.minTime}}" end="23:59" bindchange="onSuppTime">
            <view class="od-supp-field row-between">
              <text class="od-supp-label">离场时间</text>
              <text class="{{supp.time ? 'num-font bold' : 'placeholder'}}">{{supp.time || '请选择'}}</text>
            </view>
          </picker>
          <view class="od-supp-label od-supp-label-top">补录原因（必填）</view>
          <textarea class="od-supp-input" value="{{supp.reason}}" placeholder="如：手机电量耗尽，工程师电话确认约 18:20 离场" placeholder-class="placeholder" maxlength="200" auto-height bindinput="onSuppReason" />
          <view class="row od-supp-actions">
            <view class="od-supp-save {{busy ? 'disabled' : ''}}" hover-class="btn-hover" bindtap="saveSupp">保存补录</view>
            <view class="od-supp-cancel" hover-class="btn-hover" bindtap="cancelSupp">取消</view>
          </view>
          <view class="od-supp-note">保存后记录补录人和时间，导出时单独标注</view>
        </view>
      </block>
    </view>

    <!-- 转交待确认（v1.3；按钮只看 actions：接手人「确认接手 / 拒绝」，发起人「撤回转交」，主管「撤销转交」） -->
    <view wx:if="{{transferCard}}" class="od-req">
      <view class="row-between">
        <text class="od-req-title">转交待确认</text>
        <text class="od-req-time num-font">{{transferCard.time}}</text>
      </view>
      <view class="od-req-text">{{transferCard.text}}</view>
      <view class="od-req-reason">原因：{{transferCard.reason}}</view>
      <view wx:if="{{transferCard.canAccept || transferCard.canReject}}" class="row od-req-actions">
        <view wx:if="{{transferCard.canAccept}}" class="od-req-btn primary {{busy ? 'disabled' : ''}}" hover-class="btn-hover" bindtap="onAcceptTransfer" aria-role="button">确认接手</view>
        <view wx:if="{{transferCard.canReject}}" class="od-req-btn" hover-class="btn-hover" bindtap="onRejectTransfer" aria-role="button">拒绝</view>
      </view>
      <view wx:elif="{{transferCard.canCancel}}" class="row od-req-actions">
        <view class="flex1"></view>
        <view class="od-req-btn small" hover-class="btn-hover" bindtap="onCancelTransfer" aria-role="button">{{transferCard.cancelLabel}}</view>
      </view>
    </view>
    <view wx:elif="{{transferRejected}}" class="od-req-rejected">{{transferRejected}}</view>

    <!-- 待审批的申请（暂停 / 协助人） -->
    <view wx:for="{{requests}}" wx:key="id" class="od-req">
      <view class="row-between">
        <text class="od-req-title">{{item.title}}</text>
        <text class="od-req-time num-font">{{item.time}}</text>
      </view>
      <view class="od-req-text">{{item.text}}</view>
      <view wx:if="{{item.canDecide}}" class="row od-req-actions">
        <view class="od-req-btn primary {{busy ? 'disabled' : ''}}" hover-class="btn-hover" data-id="{{item.id}}" bindtap="onApproveRequest" aria-role="button">同意</view>
        <view class="od-req-btn" hover-class="btn-hover" data-id="{{item.id}}" bindtap="onRejectRequest" aria-role="button">驳回</view>
      </view>
      <view wx:elif="{{item.canCancel}}" class="row od-req-actions">
        <text class="flex1 od-req-wait">等待主管审批</text>
        <view class="od-req-btn small" hover-class="btn-hover" data-id="{{item.id}}" bindtap="onCancelRequest" aria-role="button">撤回</view>
      </view>
      <view wx:else class="od-req-wait od-req-wait-top">等待主管审批</view>
    </view>
    <view wx:if="{{requestRejected}}" class="od-req-rejected">{{requestRejected}}</view>

    <!-- tabs -->
    <view class="segmented od-tabs" aria-role="tablist">
      <view wx:for="{{tabs}}" wx:key="key" class="segmented-item {{tab === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onTab" aria-role="tab" aria-selected="{{tab === item.key}}">{{item.label}}</view>
    </view>

    <view class="od-main">
      <!-- 暂停提示：工程师在「信息」顶部（返厂单默认停在「返厂流程」，那里也显示），销售 / 主管在「进度」顶部 -->
      <view wx:if="{{holdBar && (isEngineerView ? (tab === 'info' || tab === 'factory') : tab === 'progress')}}" class="od-holdbar">
        <view class="od-holdbar-mark"><view class="od-holdbar-bar"></view><view class="od-holdbar-bar"></view></view>
        <view class="flex1">
          <view class="od-holdbar-text">{{holdBar.text}}</view>
          <view class="od-holdbar-sub num-font">{{holdBar.sub}}</view>
        </view>
      </view>

      <!-- 返厂流程（仅返厂单）：工程师在「返厂流程」tab，销售 / 主管在「进度」tab 顶部 -->
      <block wx:if="{{factoryNodes.length && (tab === 'factory' || tab === 'progress')}}">
        <view class="od-card od-factory">
          <view class="od-h3">返厂流程</view>
          <view wx:for="{{factoryNodes}}" wx:key="node" class="od-step od-fnode">
            <view class="od-rail">
              <view class="od-step-dot f-{{item.state}}"></view>
              <view wx:if="{{!item.last}}" class="od-step-line {{item.lineOn ? 'on' : ''}}"></view>
            </view>
            <view class="od-step-body od-fnode-body">
              <view class="row od-fnode-head">
                <text class="od-step-title {{item.state === 'current' ? 'red' : ''}} {{item.state === 'todo' || item.skipped ? 'muted' : ''}}">{{item.label}}</text>
                <text wx:if="{{item.skipped}}" class="tag tag-sm od-fnode-skip">已跳过</text>
                <view class="flex1"></view>
                <text wx:if="{{item.canEdit}}" class="od-link" data-node="{{item.node}}" bindtap="onFactoryNode" aria-role="button">更正</text>
              </view>
              <view wx:if="{{item.sub}}" class="od-step-sub num-font {{item.subClass}}">{{item.sub}}</view>
              <view wx:if="{{item.trackingNo}}" class="od-track" hover-class="btn-hover" data-no="{{item.trackingNo}}" bindtap="onCopyTracking"
                    aria-role="button" aria-label="复制快递单号 {{item.trackingNo}}">
                <text class="od-track-courier">{{item.courier}}</text>
                <text class="od-track-no num-font">{{item.trackingNo}}</text>
                <text class="od-track-copy">复制</text>
              </view>
              <view wx:if="{{item.note}}" class="od-fnode-note">备注：{{item.note}}</view>
              <view wx:if="{{item.photos.length}}" class="od-fnode-photos">
                <image wx:for="{{item.photos}}" wx:for-item="ph" wx:key="id" class="od-thumb" src="{{ph.url}}" mode="aspectFill" lazy-load
                       data-node="{{item.node}}" data-url="{{ph.url}}" bindtap="onPreviewFactoryPhoto" aria-label="{{item.label}}照片" />
              </view>
              <view wx:if="{{item.canRecord}}" class="od-fnode-btn" hover-class="btn-hover" data-node="{{item.node}}" bindtap="onFactoryNode" aria-role="button">{{item.actionLabel}}</view>
            </view>
          </view>
        </view>
        <view wx:if="{{tab === 'factory'}}" class="od-note">返厂工单无需打卡。工厂收货后自动进入「处理中」，寄回客户后才能提交完工；点击快递单号可复制。</view>
      </block>

      <!-- 进度（销售 / 主管） -->
      <block wx:if="{{tab === 'progress'}}">
        <view wx:if="{{closeHintText}}" class="od-hint-line {{factoryNodes.length ? 'mt-card' : ''}}">{{closeHintText}}</view>
        <view class="od-card od-progress {{factoryNodes.length && !closeHintText ? 'mt-card' : ''}}">
          <view wx:for="{{steps}}" wx:key="key" class="od-step" data-url="{{item.photo}}" bindtap="onPreviewPhoto">
            <view class="od-rail">
              <view class="od-step-dot {{item.state}}"></view>
              <view wx:if="{{!item.last}}" class="od-step-line {{item.lineOn ? 'on' : ''}}"></view>
            </view>
            <view class="od-step-body">
              <view class="od-step-title {{item.state === 'current' ? 'red' : ''}} {{item.state === 'future' ? 'muted' : ''}} {{item.state === 'paused' ? 'paused' : ''}}">{{item.title}}</view>
              <view class="od-step-sub num-font {{item.subClass}}">{{item.sub}}</view>
            </view>
            <text class="od-step-tag" style="color: {{item.tagColor}};">{{item.tag}}</text>
          </view>
          <view wx:if="{{!steps.length}}" class="od-empty-line muted">暂无记录</view>
        </view>
        <view class="od-note">{{progressNote}}</view>
      </block>

      <!-- 信息 -->
      <block wx:if="{{tab === 'info'}}">
        <view class="od-card">
          <view class="od-h3">故障情况</view>
          <view class="od-quote">“{{order.symptom}}”</view>
          <view wx:for="{{infoRows}}" wx:key="key" class="od-kv">
            <text class="od-kv-label">{{item.label}}</text>
            <text class="od-kv-value">{{item.value}}</text>
          </view>
          <block wx:if="{{!isEngineerView}}">
            <view class="od-kv" wx:if="{{order.contactName || order.contactPhone}}" data-phone="{{order.contactPhone}}" bindtap="onCall">
              <text class="od-kv-label">客户联系人</text>
              <text class="od-kv-value">{{order.contactName}}<text wx:if="{{order.contactPhone}}"> · <text class="num-font">{{contactPhoneText}}</text></text></text>
            </view>
            <view class="od-kv" wx:if="{{order.address}}" bindtap="onNav">
              <text class="od-kv-label">客户地址</text>
              <text class="od-kv-value">{{order.address}}</text>
            </view>
          </block>
        </view>

        <!-- 客户（工程师视角） -->
        <view wx:if="{{isEngineerView}}" class="od-card mt-card">
          <view class="od-h3">客户</view>
          <view class="od-contact row">
            <view class="flex1">
              <view class="od-contact-name">{{order.contactName || '—'}}</view>
              <view class="od-contact-phone num-font">{{contactPhoneText}}</view>
            </view>
            <view wx:if="{{order.contactPhone}}" class="od-circle" hover-class="btn-hover" data-phone="{{order.contactPhone}}" bindtap="onCall" aria-role="button" aria-label="拨打客户电话">
              <ui-icon name="phone" size="20" stroke="2" />
            </view>
          </view>
          <view class="od-addr row">
            <view class="flex1 od-addr-text">{{order.address || '—'}}</view>
            <view wx:if="{{canNav}}" class="od-circle" hover-class="btn-hover" bindtap="onNav" aria-role="button" aria-label="导航到客户地址">
              <ui-icon name="location" size="20" stroke="2" />
            </view>
          </view>
        </view>

        <!-- 设备资料（v1.3：项目编号 / 多台设备 / SAT 信息；「修改 SAT」按 canEditSat） -->
        <view wx:if="{{deviceCard}}" class="od-card mt-card">
          <view class="row-between od-h3">
            <text>设备资料</text>
            <text wx:if="{{order.canEditSat}}" class="od-link" bindtap="openSatSheet" aria-role="button">修改 SAT</text>
          </view>
          <view class="od-kv first">
            <text class="od-kv-label">项目编号</text>
            <text class="od-kv-value">{{deviceCard.projectNo}}</text>
          </view>
          <block wx:for="{{deviceCard.devices}}" wx:for-item="dev" wx:key="key">
            <view class="od-dev-title">{{dev.title}}</view>
            <view wx:for="{{dev.rows}}" wx:for-item="r" wx:key="label" class="od-kv od-dev-kv {{r.last ? 'last' : ''}}">
              <text class="od-kv-label">{{r.label}}</text>
              <text class="od-kv-value">{{r.value}}</text>
            </view>
          </block>
          <view wx:if="{{!deviceCard.devices.length}}" class="od-kv">
            <text class="od-kv-label">设备</text>
            <text class="od-kv-value muted">未填设备</text>
          </view>
          <view class="od-kv">
            <text class="od-kv-label">是否已完成 SAT</text>
            <text class="od-kv-value">{{deviceCard.satText}}</text>
          </view>
          <view class="od-kv">
            <text class="od-kv-label">{{deviceCard.satDateLabel}}</text>
            <text class="od-kv-value {{deviceCard.satDateEmpty ? 'muted' : 'num-font'}}">{{deviceCard.satDate}}</text>
          </view>
        </view>

        <!-- 处理人员（负责人 + 协助人 + 已退出，每人工时） -->
        <view wx:if="{{participants.length}}" class="od-card mt-card">
          <view class="row-between od-h3">
            <text>处理人员</text>
            <text wx:if="{{canAssistants}}" class="od-link" bindtap="onEditAssistants" aria-role="button">调整协助人</text>
            <text wx:elif="{{canRequestAssistant}}" class="od-link" bindtap="onRequestAssistant" aria-role="button">申请协助人</text>
          </view>
          <view wx:for="{{participants}}" wx:key="key" class="od-person {{index === 0 ? 'first' : ''}}">
            <avatar user="{{item.user}}" size="32" />
            <view class="flex1 row od-person-main">
              <text class="od-person-name ellipsis">{{item.name}}</text>
              <text class="tag tag-sm od-role {{item.roleClass}}">{{item.roleLabel}}</text>
              <text wx:if="{{item.exitText}}" class="od-person-exit">{{item.exitText}}</text>
              <text wx:if="{{item.onSite}}" class="od-person-flag">现场中</text>
              <text wx:if="{{item.missing}}" class="od-person-flag">缺卡</text>
            </view>
            <text wx:if="{{item.hours}}" class="od-person-hours num-font">{{item.hours}}</text>
          </view>
        </view>

        <!-- 完工信息 -->
        <view wx:if="{{completionRows.length}}" class="od-card mt-card">
          <view class="od-h3">完工信息</view>
          <view wx:for="{{completionRows}}" wx:key="key" class="od-kv {{index === 0 ? 'first' : ''}}">
            <text class="od-kv-label">{{item.label}}</text>
            <text class="od-kv-value" style="{{item.color ? 'color: ' + item.color + '; font-weight: 600;' : ''}}">{{item.value}}</text>
          </view>
        </view>

        <!-- 工单信息 -->
        <view class="od-card mt-card">
          <view class="od-h3">工单信息</view>
          <view wx:for="{{orderRows}}" wx:key="key" class="od-kv {{index === 0 ? 'first' : ''}}">
            <text class="od-kv-label">{{item.label}}</text>
            <text class="od-kv-value">{{item.value}}</text>
          </view>
        </view>
      </block>

      <!-- 打卡记录（工程师） -->
      <block wx:if="{{tab === 'punch'}}">
        <view wx:if="{{order.serviceType !== 'Onsite'}}">
          <empty text="{{order.serviceType === 'Remote' ? '远程' : '返厂'}}工单无需打卡" />
        </view>
        <view wx:elif="{{!days.length}}">
          <empty text="暂无打卡记录" desc="到达客户现场后点「打卡」拍照打卡" />
        </view>
        <view wx:for="{{days}}" wx:for-item="day" wx:key="date" class="od-card od-day {{index > 0 ? 'mt-card' : ''}}">
          <view class="od-day-head" data-date="{{day.date}}" bindtap="onToggleDay">
            <view class="flex1">
              <view class="od-day-title">{{day.title}}</view>
              <view wx:if="{{!day.running && day.sub}}" class="od-day-sub num-font {{day.missing ? 'red' : ''}}">{{day.sub}}</view>
            </view>
            <text wx:if="{{day.running}}" class="od-day-running num-font">{{day.runningText}}</text>
            <text wx:else class="od-day-dur num-font">{{day.dur}}</text>
            <view class="od-day-arrow {{day.expanded ? 'open' : ''}}"><ui-icon name="down" color="#AEAEB2" size="16" stroke="2" /></view>
          </view>
          <view wx:if="{{day.expanded}}" class="od-day-body">
            <view wx:for="{{day.entries}}" wx:key="key" class="od-entry">
              <view class="od-rail">
                <view class="od-entry-dot {{item.dot}}"></view>
                <view wx:if="{{!item.last}}" class="od-entry-line"></view>
              </view>
              <view class="od-entry-body">
                <view class="od-entry-kind">{{item.kind}} <text class="od-entry-time num-font {{item.dot === 'missing' ? 'red' : ''}}">{{item.time}}</text></view>
                <view wx:if="{{item.note}}" class="od-entry-note {{item.noteClass}}">{{item.note}}</view>
              </view>
              <view class="od-entry-side">
                <text wx:if="{{item.dur}}" class="od-entry-dur num-font {{item.durClass}}">{{item.dur}}</text>
                <image wx:if="{{item.photo}}" class="od-thumb" src="{{item.photo}}" mode="aspectFill" lazy-load data-url="{{item.photo}}" catchtap="onPreviewPhoto" aria-label="打卡照片" />
              </view>
            </view>
          </view>
        </view>
      </block>

      <!-- 附件资料（v1.2：附件 + 流程资料；v1.3：附件按三类分组，空组也显示标题和「暂无」；「添加」只看 canAddAttachment，已闭环也可以） -->
      <block wx:if="{{tab === 'files'}}">
        <view class="od-card od-atts">
          <view class="od-h3">附件（{{attachTotal}}）</view>
          <block wx:for="{{attachGroups}}" wx:for-item="grp" wx:for-index="gi" wx:key="type">
            <view class="od-att-group {{gi === 0 ? 'first' : ''}}">
              <text class="flex1 od-att-group-title">{{grp.label}}（{{grp.count}}）</text>
              <text wx:if="{{canAddAttachment}}" class="od-link" data-att-type="{{grp.type}}" bindtap="openAttachSheet" aria-role="button" aria-label="添加{{grp.label}}">添加</text>
            </view>
            <view wx:for="{{grp.items}}" wx:key="id" class="od-att {{item.first ? 'first' : ''}}" hover-class="od-file-hover"
                  data-id="{{item.id}}" bindtap="onAttachmentTap" aria-role="button" aria-label="打开附件 {{item.name}}">
              <view class="od-att-badge" style="background: {{item.badgeColor}};">{{item.badgeText}}</view>
              <view class="flex1">
                <view class="od-att-name ellipsis">{{item.name}}</view>
                <view class="od-att-sub num-font ellipsis">{{item.sub}}</view>
                <view wx:if="{{item.restricted}}" class="od-att-tags"><text class="tag tag-sm tag-amber">仅销售和主管可见</text></view>
              </view>
              <view wx:if="{{item.hasMenu}}" class="od-att-more" hover-class="btn-hover" hover-stop-propagation data-id="{{item.id}}" catchtap="onAttachmentMore"
                    aria-role="button" aria-label="更多操作">
                <ui-icon name="more" color="#6E6E73" size="22" stroke="3" />
              </view>
            </view>
            <view wx:if="{{!grp.count}}" class="od-att-none">暂无</view>
          </block>
        </view>

        <view class="od-sub-title">流程资料</view>
        <view class="od-card od-files">
          <view wx:for="{{files}}" wx:key="key" class="od-file" hover-class="od-file-hover" data-key="{{item.key}}" bindtap="onPreviewFiles">
            <view class="flex1">
              <view class="od-file-title">{{item.title}}</view>
              <view class="od-file-desc">{{item.desc}}</view>
            </view>
            <text class="od-file-count {{item.warn ? 'amber' : ''}}">{{item.text}}</text>
            <ui-icon name="right" color="#AEAEB2" size="18" stroke="2" />
          </view>
        </view>
      </block>
    </view>

    <view wx:if="{{buttons.length}}" class="footer-space"></view>
    <view wx:else class="safe-bottom"></view>
  </block>
</view>

<!-- 底部操作 -->
<view wx:if="{{order && buttons.length}}" class="footer-bar od-footer">
  <view wx:for="{{buttons}}" wx:key="key" class="od-btn {{item.kind}} {{item.wide ? 'wide' : ''}}" hover-class="{{item.disabled ? 'none' : 'btn-hover'}}" data-key="{{item.key}}" bindtap="onAction" aria-role="button" aria-disabled="{{item.disabled}}">{{item.label}}</view>
</view>

<!-- 指派 / 改派 / 调整协助人 / 申请协助人 / 转交（v1.3，mode = transfer） -->
<assign-sheet show="{{sheetShow}}" order="{{order}}" mode="{{sheetMode}}" bind:done="onAssigned" bind:close="onSheetClose" />

<!-- 暂停搁置（主管）/ 申请暂停（负责工程师） -->
<block wx:if="{{holdSheet.show}}">
  <view class="mask" bindtap="closeHoldSheet" catchtouchmove="noop"></view>
  <view class="sheet od-appt" catchtouchmove="noop">
    <view class="sheet-handle"></view>
    <view class="row-between od-appt-head">
      <text class="od-appt-title">{{holdSheet.title}}</text>
      <text class="muted od-appt-cancel" bindtap="closeHoldSheet">取消</text>
    </view>
    <view class="od-appt-sub muted">{{holdSheet.mode === 'request' ? '提交后由主管审批，同意后工单进入「暂停搁置」' : '暂停期间不能打卡、开始处理和提交完工，恢复后回到暂停前的状态'}}</view>
    <view class="od-sheet-label">暂停原因</view>
    <view class="od-reasons" aria-role="radiogroup">
      <view wx:for="{{holdReasons}}" wx:key="value" class="chip od-reason {{holdSheet.reasonType === item.value ? 'active' : ''}}"
            data-value="{{item.value}}" bindtap="onHoldReason" aria-role="radio" aria-checked="{{holdSheet.reasonType === item.value}}">{{item.label}}</view>
    </view>
    <view class="od-sheet-label">说明<text class="od-sheet-opt">{{holdSheet.reasonType === 'Other' ? '（必填）' : '（选填）'}}</text></view>
    <input class="od-sheet-input" value="{{holdSheet.note}}" bindinput="onHoldNote" maxlength="200" cursor-spacing="160"
           placeholder="{{holdPlaceholder}}" placeholder-class="placeholder" />
    <view class="btn-primary od-appt-btn {{busy ? 'btn-disabled' : ''}}" hover-class="btn-hover" bindtap="saveHold">确定</view>
  </view>
</block>

<!-- 定价（主管）/ 价格建议（销售） -->
<block wx:if="{{priceSheet.show}}">
  <view class="mask" bindtap="closePriceSheet" catchtouchmove="noop"></view>
  <view class="sheet od-appt" catchtouchmove="noop">
    <view class="sheet-handle"></view>
    <view class="row-between od-appt-head">
      <text class="od-appt-title">{{priceSheet.title}}</text>
      <text class="muted od-appt-cancel" bindtap="closePriceSheet">取消</text>
    </view>
    <view class="od-appt-sub muted">{{priceSheet.hint}}</view>
    <view wx:if="{{priceSheet.suggestText}}" class="od-adopt row">
      <text class="flex1 od-adopt-text">{{priceSheet.suggestText}}</text>
      <view class="od-adopt-btn" hover-class="btn-hover" bindtap="onAdoptSuggestion" aria-role="button">采用建议</view>
    </view>
    <view class="od-amount row">
      <text class="od-sheet-label od-amount-label">{{priceSheet.mode === 'suggest' ? '建议价格' : '服务价格'}}</text>
      <view class="flex1"></view>
      <text class="od-yen">¥</text>
      <input class="od-amount-input" type="digit" value="{{priceSheet.amount}}" bindinput="onPriceAmount" placeholder="0" placeholder-class="placeholder" maxlength="12" cursor-spacing="200" />
    </view>
    <block wx:if="{{priceSheet.mode === 'suggest'}}">
      <view class="od-sheet-label">备注<text class="od-sheet-opt">（选填）</text></view>
      <input class="od-sheet-input" value="{{priceSheet.note}}" bindinput="onPriceNote" maxlength="200" cursor-spacing="160"
             placeholder="如：老客户，建议优惠" placeholder-class="placeholder" />
    </block>
    <view class="btn-primary od-appt-btn {{busy ? 'btn-disabled' : ''}}" hover-class="btn-hover" bindtap="savePrice">{{priceSheet.mode === 'suggest' ? '提交建议' : '确定'}}</view>
  </view>
</block>

<!-- 添加附件（v1.2）。只在非滚动区域拦截 touchmove，已选列表 scroll-view 不拦截 -->
<block wx:if="{{attachSheet.show}}">
  <view class="mask" bindtap="closeAttachSheet" catchtouchmove="noop"></view>
  <view class="sheet od-appt" aria-role="dialog" aria-label="添加附件">
    <view catchtouchmove="noop">
      <view class="sheet-handle"></view>
      <view class="row-between od-appt-head">
        <text class="od-appt-title">添加附件</text>
        <text class="muted od-appt-cancel" bindtap="closeAttachSheet">取消</text>
      </view>
      <!-- 类别（v1.3）：本次添加的附件整批归入所选类别。用 data-att-type，下面两个选择按钮的 data-type 是 media | chat -->
      <view class="od-sheet-label od-att-type-label">类别</view>
      <view class="od-reasons" aria-role="radiogroup">
        <view wx:for="{{attachTypes}}" wx:key="value" class="chip od-reason {{attachSheet.type === item.value ? 'active' : ''}}"
              data-att-type="{{item.value}}" bindtap="onAttachType" aria-role="radio" aria-checked="{{attachSheet.type === item.value}}">{{item.short}}</view>
      </view>
      <view wx:if="{{attachSheet.canRestrict}}" class="row od-att-switch">
        <view class="flex1">
          <view class="od-att-switch-title">仅销售和主管可见</view>
          <view class="od-att-switch-sub">打开后本次添加的附件工程师看不到</view>
        </view>
        <switch checked="{{attachSheet.restricted}}" color="#1D1D1F" bindchange="onAttachRestricted" />
      </view>
      <view class="row od-att-picks">
        <view class="od-att-pick" hover-class="btn-hover" data-type="media" bindtap="onAttachPick" aria-role="button">拍照或从相册选择</view>
        <view class="od-att-pick" hover-class="btn-hover" data-type="chat" bindtap="onAttachPick" aria-role="button">从微信聊天选择文件</view>
      </view>
      <view class="od-att-hint">{{attachHint}}</view>
    </view>
    <scroll-view wx:if="{{attachSheet.items.length}}" scroll-y class="od-att-picked" aria-label="已选附件">
      <view wx:for="{{attachSheet.items}}" wx:key="key" class="od-att-item {{index === 0 ? 'first' : ''}}">
        <view class="od-att-badge sm" style="background: {{item.badgeColor}};" data-key="{{item.key}}" bindtap="onAttachPreview">{{item.badgeText}}</view>
        <view class="flex1" data-key="{{item.key}}" bindtap="onAttachPreview">
          <view class="od-att-name ellipsis">{{item.name}}</view>
          <view class="od-att-sub num-font">
            <text>{{item.sizeText}}</text>
            <text wx:if="{{item.status === 'uploading'}}"> · 上传中 {{item.percent}}%</text>
            <text wx:elif="{{item.status === 'done'}}"> · 已上传</text>
          </view>
          <view wx:if="{{item.status === 'fail'}}" class="od-att-err">{{item.error || '上传失败'}}</view>
        </view>
        <text wx:if="{{item.status === 'fail' && !item.fatal}}" class="od-att-op" data-key="{{item.key}}" bindtap="onAttachRetry" aria-role="button">重试</text>
        <text class="od-att-op muted" data-key="{{item.key}}" bindtap="onAttachRemove" aria-role="button">移除</text>
      </view>
    </scroll-view>
    <view catchtouchmove="noop">
      <view class="btn-primary od-appt-btn od-att-btn {{attachSheet.uploading || busy || !attachSheet.doneCount ? 'btn-disabled' : ''}}"
            hover-class="{{attachSheet.uploading || busy ? 'none' : 'btn-hover'}}" bindtap="saveAttachments" aria-role="button"
            aria-disabled="{{attachSheet.uploading || busy}}">{{attachSheet.uploading ? '上传中…' : '确定添加（' + attachSheet.doneCount + '）'}}</view>
    </view>
  </view>
</block>

<!-- 修改 SAT 信息（v1.3） -->
<block wx:if="{{satSheet.show}}">
  <view class="mask" bindtap="closeSatSheet" catchtouchmove="noop"></view>
  <view class="sheet od-appt" catchtouchmove="noop" aria-role="dialog" aria-label="修改 SAT 信息">
    <view class="sheet-handle"></view>
    <view class="row-between od-appt-head">
      <text class="od-appt-title">修改 SAT 信息</text>
      <text class="muted od-appt-cancel" bindtap="closeSatSheet">取消</text>
    </view>
    <view class="od-appt-sub muted">接单时拿不到的时间可以之后补填。</view>
    <view class="od-sheet-label">是否已完成 SAT</view>
    <view class="od-reasons" aria-role="radiogroup">
      <view class="chip od-reason {{satSheet.satSigned ? 'active' : ''}}" data-v="1" bindtap="onSatChoose" aria-role="radio" aria-checked="{{satSheet.satSigned}}">已完成</view>
      <view class="chip od-reason {{satSheet.satSigned ? '' : 'active'}}" data-v="0" bindtap="onSatChoose" aria-role="radio" aria-checked="{{!satSheet.satSigned}}">未完成</view>
    </view>
    <view class="form-item od-sat-row">
      <picker class="flex1" mode="date" fields="day" value="{{satSheet.satDate || satSheet.pickerValue}}" bindchange="onSatDate">
        <view class="row od-sat-pick">
          <text class="od-sat-label">{{satSheet.label}}</text>
          <text class="flex1 od-sat-value num-font {{satSheet.satDate ? '' : 'placeholder'}}">{{satSheet.satDate || '选填'}}</text>
          <ui-icon wx:if="{{!satSheet.satDate}}" name="right" color="#AEAEB2" size="18" stroke="2" />
        </view>
      </picker>
      <text wx:if="{{satSheet.satDate}}" class="od-sat-clear" catchtap="onSatClear" aria-role="button">清除</text>
    </view>
    <view wx:if="{{satSheet.legacy}}" class="od-sat-legacy">原记录：{{satSheet.legacy}}</view>
    <view class="btn-primary od-appt-btn {{busy ? 'btn-disabled' : ''}}" hover-class="btn-hover" bindtap="saveSat">保存</view>
  </view>
</block>

<!-- 设置预约 -->
<block wx:if="{{apptShow}}">
  <view class="mask" bindtap="closeAppt" catchtouchmove="noop"></view>
  <view class="sheet od-appt" catchtouchmove="noop">
    <view class="sheet-handle"></view>
    <view class="row-between od-appt-head">
      <text class="od-appt-title">设置预约</text>
      <text class="muted od-appt-cancel" bindtap="closeAppt">取消</text>
    </view>
    <view class="od-appt-sub muted">与客户约定的上门 / 处理时间</view>
    <picker mode="date" value="{{apptDate}}" start="{{apptStart}}" bindchange="onApptDate">
      <view class="form-item">
        <text class="form-label">日期</text>
        <text class="form-input num-font">{{apptDate || '请选择'}}</text>
        <ui-icon name="right" color="#AEAEB2" size="18" stroke="2" />
      </view>
    </picker>
    <picker mode="time" value="{{apptTime}}" bindchange="onApptTime">
      <view class="form-item">
        <text class="form-label">时间</text>
        <text class="form-input num-font">{{apptTime || '请选择'}}</text>
        <ui-icon name="right" color="#AEAEB2" size="18" stroke="2" />
      </view>
    </picker>
    <view class="btn-primary od-appt-btn {{busy ? 'btn-disabled' : ''}}" hover-class="btn-hover" bindtap="saveAppt">确定</view>
  </view>
</block>
