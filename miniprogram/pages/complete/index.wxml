<nav-bar title="完工提交" />

<view class="page cp">
  <view wx:if="{{loading && !order}}" class="cp-state muted">加载中…</view>
  <empty wx:elif="{{loadError && !order}}" text="{{loadError}}">
    <button class="btn-sm btn-secondary" hover-class="btn-hover" bindtap="onRetry">重新加载</button>
  </empty>

  <block wx:else>
    <view class="cp-notice">提交后工单进入「待验收」，主管确认后闭环</view>

    <view class="cp-order">
      <text class="cp-order-name ellipsis flex1">{{order.customerName}}</text>
      <text class="cp-order-no num">{{order.orderNo}}</text>
    </view>

    <view wx:if="{{!canSubmit}}" class="cp-warn">
      <ui-icon name="warning" color="#9A5B00" size="16" stroke="2" />
      <text class="flex1">{{blockText}}</text>
    </view>
    <view wx:elif="{{onSite}}" class="cp-warn" bindtap="goCheckin">
      <ui-icon name="warning" color="#9A5B00" size="16" stroke="2" />
      <text class="flex1">你还在现场计时中，提交完工前请先离场打卡</text>
      <text class="cp-warn-link">去打卡</text>
    </view>

    <!-- 文本 -->
    <view wx:if="{{mode === 'Install'}}" class="cp-card">
      <view class="cp-field">
        <view class="cp-label">安装调试情况 <text class="red">*</text></view>
        <textarea class="cp-textarea" value="{{solution}}" data-field="solution" bindinput="onInput"
          auto-height maxlength="1000" disable-default-padding placeholder="如：2 台设备就位、接线、通水通气完成；升温、搅拌、压力测试通过，已培训客户操作人员"
          placeholder-class="placeholder" />
      </view>
      <view class="cp-field cp-field-last">
        <view class="cp-label">遗留问题</view>
        <input class="cp-input" value="{{openIssues}}" data-field="openIssues" bindinput="onInput"
          maxlength="500" placeholder="没有可不填，如：客户冷却水压力偏低" placeholder-class="placeholder" />
      </view>
    </view>
    <view wx:else class="cp-card">
      <view class="cp-field">
        <view class="cp-label">{{mode === 'Onsite' ? '现场确认的故障原因' : '故障原因'}} <text class="red">*</text></view>
        <textarea class="cp-textarea" value="{{faultCause}}" data-field="faultCause" bindinput="onInput"
          auto-height maxlength="500" disable-default-padding placeholder="如：加热棒接线端子氧化，接触不良"
          placeholder-class="placeholder" />
      </view>
      <view class="cp-field">
        <view class="cp-label">解决措施 <text class="red">*</text></view>
        <textarea class="cp-textarea" value="{{solution}}" data-field="solution" bindinput="onInput"
          auto-height maxlength="1000" disable-default-padding placeholder="处理过程与验证结果"
          placeholder-class="placeholder" />
      </view>
      <view class="cp-field cp-field-last">
        <view class="cp-label">更换备件</view>
        <input class="cp-input" value="{{partsReplaced}}" data-field="partsReplaced" bindinput="onInput"
          maxlength="200" placeholder="没有可不填，如：接线端子 ×2" placeholder-class="placeholder" />
      </view>
    </view>

    <!-- v2.1 工作内容：之前一条都没写过时在这里补 -->
    <view wx:if="{{needWork}}" class="cp-card cp-mt">
      <view class="cp-field cp-field-last">
        <view class="cp-label">工作内容 <text class="red">*</text></view>
        <textarea class="cp-textarea" value="{{workContent}}" data-field="workContent" bindinput="onInput"
          auto-height maxlength="1000" disable-default-padding placeholder="这张单上做了哪些工作。之后可以在工单详情里按天写"
          placeholder-class="placeholder" />
      </view>
    </view>

    <!-- 运行状况 -->
    <view class="cp-card cp-mt" role="radiogroup">
      <view class="cp-label cp-radio-title">设备运行状况 <text class="red">*</text></view>
      <view wx:for="{{runOptions}}" wx:key="value" class="cp-radio {{index === runOptions.length - 1 ? 'last' : ''}}"
        data-value="{{item.value}}" bindtap="onPickRun" aria-role="radio" aria-checked="{{runStatus === item.value}}">
        <text>{{item.label}}</text>
        <view class="cp-ring {{runStatus === item.value ? 'on' : ''}}"><view class="cp-ring-dot"></view></view>
      </view>
    </view>

    <!-- 远程：客户确认方式 -->
    <view wx:if="{{mode === 'Remote'}}" class="cp-card cp-mt" role="radiogroup">
      <view class="cp-label cp-radio-title">客户确认方式 <text class="red">*</text></view>
      <view class="cp-photo-tip cp-confirm-tip">客户是怎么确认问题已经解决的</view>
      <view class="cp-chips">
        <view wx:for="{{confirmOptions}}" wx:key="*this" class="chip cp-chip {{customerConfirm === item ? 'active' : ''}}"
          data-value="{{item}}" bindtap="onPickConfirm" aria-role="radio" aria-checked="{{customerConfirm === item}}">{{item}}</view>
      </view>
    </view>

    <!-- 返厂：寄回前测试结果 -->
    <view wx:if="{{mode === 'Factory'}}" class="cp-card cp-mt">
      <view class="cp-field cp-field-last">
        <view class="cp-label">寄回前测试结果 <text class="red">*</text></view>
        <textarea class="cp-textarea" value="{{testResult}}" data-field="testResult" bindinput="onInput"
          auto-height maxlength="500" disable-default-padding placeholder="如：整机功能测试通过，连续运行 2 小时正常"
          placeholder-class="placeholder" />
      </view>
    </view>

    <!-- 照片 / 登记表：按服务方式显示不同的上传区 -->
    <view wx:for="{{sections}}" wx:for-item="sec" wx:key="list" class="cp-card cp-mt">
      <view class="cp-photo-head">
        <text class="cp-label">{{sec.title}} <text wx:if="{{sec.required}}" class="red">*</text></text>
        <text wx:if="{{sec.existing}}" class="cp-photo-tip green">附件里已有 {{sec.existing}} 份，可不再传</text>
        <text wx:else class="cp-photo-tip">{{sec.tip}}</text>
      </view>
      <view class="cp-grid">
        <view wx:for="{{lists[sec.list]}}" wx:key="key" class="cp-thumb" data-list="{{sec.list}}" data-key="{{item.key}}" bindtap="onTapPhoto">
          <image class="cp-thumb-img" src="{{item.path}}" mode="aspectFill" />
          <view wx:if="{{item.status === 'uploading'}}" class="cp-thumb-mask">上传中</view>
          <view wx:elif="{{item.status === 'fail'}}" class="cp-thumb-mask fail"><view>上传失败</view><view>点击重试</view></view>
          <view class="cp-thumb-del" data-list="{{sec.list}}" data-key="{{item.key}}" catchtap="onRemovePhoto" aria-role="button" aria-label="删除">
            <ui-icon name="close" color="#FFFFFF" size="10" stroke="2.6" />
          </view>
        </view>
        <view wx:if="{{lists[sec.list].length < maxPhotos}}" class="cp-add" hover-class="btn-hover" data-list="{{sec.list}}" bindtap="onAddPhoto"
          aria-role="button" aria-label="拍照添加{{sec.title}}">
          <ui-icon name="plus" color="#6E6E73" size="22" stroke="2" />
        </view>
      </view>
    </view>

    <view class="footer-space"></view>
    <view class="footer-bar">
      <button class="{{canSubmit && !submitting ? 'btn-primary' : 'btn-disabled'}} cp-submit" hover-class="btn-hover"
        bindtap="onSubmit">{{submitting ? '提交中…' : '提交完工'}}</button>
    </view>
  </block>
</view>
